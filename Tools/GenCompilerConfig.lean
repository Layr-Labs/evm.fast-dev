import Guest.Ast
import Flapjack.RiscV.NativeSource

/-! Propose literal compiler metadata. Native execution generates the candidate;
`InitECandidate.Proofs.ArtifactFacts` must prove its equality to the logical compiler output. -/
namespace GenCompilerConfig
open Flapjack Flapjack.Compiler.Backend
open Flapjack.Basis.Pure.MlString

def list (f : α → String) (xs : List α) : String :=
  "[" ++ ", ".intercalate (xs.map f) ++ "]"

def tree (f : α → String) : Spt α → String
  | .ln => ".ln"
  | .ls value => "(.ls (" ++ f value ++ "))"
  | .bn left right => "(.bn (" ++ tree f left ++ ") (" ++ tree f right ++ "))"
  | .bs left value right =>
      "(.bs (" ++ tree f left ++ ") (" ++ f value ++ ") (" ++ tree f right ++ "))"

def mlstring (s : MlString) : String :=
  "Flapjack.Basis.Pure.MlString.ofString " ++ (toStringOfBytes s).quote

def ffi : HolFfiName → String
  | .extCall name => ".extCall (" ++ mlstring name ++ ")"
  | .sharedMem .mappedRead => ".sharedMem .mappedRead"
  | .sharedMem .mappedWrite => ".sharedMem .mappedWrite"

def mmio (r : LabToTarget.ShmemInfoNum) : String :=
  "{ " ++ s!"entryPc := {r.entryPc}, nbytes := BitVec.ofNat 8 {r.nbytes.toNat}, addrReg := {r.addrReg}, addrOff := {r.addrOff}, reg := {r.reg}, exitPc := {r.exitPc}" ++ " }"

def triple (x : Nat × Nat × Nat) : String := s!"({x.1}, {x.2.1}, {x.2.2})"

def symbol (x : MlString × Nat × Nat) : String :=
  s!"({mlstring x.1}, {x.2.1}, {x.2.2})"

def laboratory (c : LabToTarget.Config) : String :=
  let names := match c.ffiNames with
    | none => "none"
    | some xs => "some " ++ list ffi xs
  "{ " ++ s!"labels := {tree (tree toString) c.labels},
    secPosLen := {list triple c.secPosLen}, pos := {c.pos}, initClock := {c.initClock},
    ffiNames := {names}, shmemExtra := {list mmio c.shmemExtra}, hashSize := {c.hashSize}" ++ " }"

def output (c : Backend.Config) : String :=
  "-- Generated by `lake exe gen-compiler-config`; proposed metadata, certified in ArtifactFacts.
import Flapjack.RiscV.NativeSource
set_option maxRecDepth 100000
namespace InitE
/-- Literal dynamic laboratory fields of the baseline compiler output. -/
def baselineLabConfig : Flapjack.Compiler.Backend.LabToTarget.Config :=
  " ++ laboratory c.labConf ++ "
/-- Only labConf and symbols change in the artifact-only backend pipeline. -/
def baselineConfigLiteral : Flapjack.Compiler.Backend.Backend.Config :=
  { Flapjack.Compiler.Backend.RiscVConfig.pancakeRiscVBackendConfig with
    labConf := baselineLabConfig,
    symbols := " ++ list symbol c.symbols ++ " }
end InitE
"
end GenCompilerConfig

def main (args : List String) : IO Unit := do
  let some (_, _, config) := Flapjack.RiscV.NativeSource.compileDeclarations Guest.guestAst
    | throw (IO.userError "guest compilation failed")
  IO.FS.writeFile (args.headD "submission/InitECandidate/Proofs/CompilerConfigLiteral.lean")
    (GenCompilerConfig.output config)
  IO.println s!"Generated {config.labConf.secPosLen.length} sections and {config.labConf.shmemExtra.length} shared-memory records"
