/* lib/secp256k1.pnk -- secp256k1 ECDSA public-key recovery (ECRECOVER).
   Port of evm-asm/EvmAsm/Stateless/SpecRef/Secp256k1Recover.lean:
     p, n, b, gx, gy      curve parameters (SEC 2 v2.0 section 2.4.1)
     pointAdd / scalarMul the affine group law with identity (Option Point)
     decompressR          x = r + (recid bit 1) * n, reject x >= p,
                          y0 = (x^3 + 7)^((p+1)/4), require y0^2 == x^3 + 7,
                          y = y0 if parity(y0) == recid bit 0 else (p - y0) % p
     recover              0 < r < n, 0 < s < n, rinv = r^(n-2) mod n,
                          u1 = (n - e mod n) mod n * rinv, u2 = s * rinv,
                          Q = u1*G + u2*R, fail at infinity
     addressOfPoint       keccak256(x || y)[12:32]
     ecrecoverAddress     v in {27, 28}, recid = v - 27

   Internally the two scalar multiplications and the final addition run in
   Jacobian coordinates (X, Y, Z) with (x, y) = (X / Z^2, Y / Z^3); the result
   is normalised to affine before use, so the returned point is exactly the
   affine value the Lean spec computes (the Jacobian formulas realise the same
   group law; the x1 == x2 case split of pointAdd -- identity when y1 + y2 == 0,
   doubling otherwise -- is reproduced on the cross-multiplied coordinates).
   A point lives in memory as 3 U256 (X at +0, Y at +32, Z at +64, little-endian
   limbs); Z == 0 encodes the identity.

   Field multiplication: reference fp_mul is a 32-bit-digit comba product whose
   512-bit result is reduced by two folds with 2^32 + 977 (p = 2^256 - 2^32 - 977).
   -DSECP_SIMPLE_MUL selects u256_mulmod instead, -DSECP_FOLD64_MUL the same
   folds on u256_mul_full 64-bit limbs (both for cross-checking).  fp_mul/fp_sqr and scalar products use the arith256_mod CSR.
   Inversion mod p and mod n is the binary extended Euclid (modinv_bin);
   -DSECP_FERMAT_INV selects the Fermat ladders a^(p-2) / a^(n-2) the Lean
   spec is written with (same values: Crypto/Fermat.lean).  Q = u1*G + u2*R
   is computed by a joint (Shamir) double-and-add; the same group element as
   Lean scalarMul + pointAdd.
   Needs lib/mem.pnk, lib/arith.pnk, lib/u256.pnk, lib/keccak.pnk. */

/* p = 2^256 - 2^32 - 977 (limbs as signed decimals: see PANCAKE-NOTES) */
#define SECP_P <-4294968273, -1, -1, -1>
#define SECP_P_MINUS_2 <-4294968275, -1, -1, -1>
/* (p + 1) / 4 = 2^254 - 2^30 - 244 */
#define SECP_SQRT_EXP <-1073742068, -1, -1, 4611686018427387903>
/* 2^32 + 977: the fold constant, p = 2^256 - SECP_C */
#define SECP_C 4294968273
/* n = FFFFFFFF FFFFFFFF FFFFFFFF FFFFFFFE BAAEDCE6 AF48A03B BFD25E8C D0364141 */
#define SECP_N <-4624529908474429119, -4994812053365940165, -2, -1>
#define SECP_N_MINUS_2 <-4624529908474429121, -4994812053365940165, -2, -1>
#define SECP_GX <6481385041966929816, 188021827762530521, 6170039885052185351, 8772561819708210092>
#define SECP_GY <-7185545363635252040, -209500633525038055, 6747795201694173352, 5204712524664259685>
#define SECP_B <7, 0, 0, 0>

#define EC_X(pt) (pt)
#define EC_Y(pt) ((pt) + 32)
#define EC_Z(pt) ((pt) + 64)
#define EC_POINT_BYTES 96

/* ZisK arith256_mod scratch (all U256 values are four little-endian u64s).
   Keep independent blocks for the two moduli used by recovery so the modulus
   and c = 0 are installed once, not on every product.  The final 128 bytes hold
   the two points for secp add.  This arena is allocated once by
   secp256k1_init, before any heap mark is taken. */
/* Foreign-call arrays (docs/ACCEL-FFI.md): each block is exactly what the accelerator
   reads and writes, at fixed offsets, with no addresses in it; the stub builds the
   CSR's pointer block from the array pointer. */
#define SECP_ACCEL_A 0
#define SECP_ACCEL_B 32
#define SECP_ACCEL_C 64
#define SECP_ACCEL_M 96
#define SECP_ACCEL_D 128
#define SECP_ACCEL_BLOCK 160
#define SECP_ACCEL_PBASE 0
#define SECP_ACCEL_NBASE SECP_ACCEL_BLOCK
/* The point-addition array: two 64-byte points, the first of which receives the sum. */
#define SECP_ACCEL_ADD (2 * SECP_ACCEL_BLOCK)
#define SECP_ACCEL_ADD_P1 0
#define SECP_ACCEL_ADD_P2 64
#define SECP_ACCEL_ADD_SIZE 128
#define SECP_ACCEL_SIZE (2 * SECP_ACCEL_BLOCK + SECP_ACCEL_ADD_SIZE)

var 1 secp_accel_scratch = 0;

fun 1 secp_accel_init_block(1 base, U256 modulus) {
  st base + SECP_ACCEL_C, U256_ZERO;
  st base + SECP_ACCEL_M, modulus;
  return 0;
}

fun 1 secp256k1_init() {
  if secp_accel_scratch != 0 {
    return 0;
  }
  secp_accel_scratch = alloc(SECP_ACCEL_SIZE);
  secp_accel_init_block(secp_accel_scratch + SECP_ACCEL_PBASE, SECP_P);
  secp_accel_init_block(secp_accel_scratch + SECP_ACCEL_NBASE, SECP_N);
  return 0;
}

fun U256 secp_accel_modmul_at(1 base, U256 a, U256 b) {
  st base + SECP_ACCEL_A, a;
  st base + SECP_ACCEL_B, b;
  @arith256mod(base, 0, base, SECP_ACCEL_BLOCK);
  return lds U256 (base + SECP_ACCEL_D);
}

fun U256 secp_accel_modmul_p(U256 a, U256 b) {
  var 1 base = secp_accel_scratch + SECP_ACCEL_PBASE;
  st base + SECP_ACCEL_A, a;
  st base + SECP_ACCEL_B, b;
  @arith256mod(base, 0, base, SECP_ACCEL_BLOCK);
  return lds U256 (base + SECP_ACCEL_D);
}

fun U256 secp_accel_modmul_n(U256 a, U256 b) {
  var 1 base = secp_accel_scratch + SECP_ACCEL_NBASE;
  st base + SECP_ACCEL_A, a;
  st base + SECP_ACCEL_B, b;
  @arith256mod(base, 0, base, SECP_ACCEL_BLOCK);
  return lds U256 (base + SECP_ACCEL_D);
}

/* ---------- field arithmetic mod p (inputs and outputs in [0, p)) ---------- */

/* (a + b) mod p; a, b < p so the exact sum is < 2p and one subtraction suffices. */
fun U256 fp_add(U256 a, U256 b) {
  var {1,1,1,1,1} s = u256_add_carry(a, b);
  var U256 r = <s.0, s.1, s.2, s.3>;
  if s.4 == 1 {
    return u256_sub(r, SECP_P);
  }
  var 1 lt = u256_lt(r, SECP_P);
  if lt == 0 {
    return u256_sub(r, SECP_P);
  }
  return r;
}

/* (a - b) mod p. */
fun U256 fp_sub(U256 a, U256 b) {
  var 1 lt = u256_lt(a, b);
  var U256 d = u256_sub(a, b);
  if lt == 1 {
    d = u256_add(d, SECP_P);
  }
  return d;
}

/* (p - a) mod p (0 for a == 0), the Lean `(p - y0) % p`. */
fun U256 fp_neg(U256 a) {
  var 1 z = u256_is_zero(a);
  if z == 1 {
    return U256_ZERO;
  }
  return u256_sub(SECP_P, a);
}

/* a mod p for any 256-bit a (one conditional subtraction, a < 2^256 < 2p). */
fun U256 fp_reduce(U256 a) {
  var 1 lt = u256_lt(a, SECP_P);
  if lt == 0 {
    return u256_sub(a, SECP_P);
  }
  return a;
}

fun U256 fp_mul(U256 a, U256 b) {
  return secp_accel_modmul_p(a, b);
}

fun U256 fp_sqr(U256 a) {
  return secp_accel_modmul_p(a, a);
}


/* Fixed-window exponentiation for the field CSRs.  The 4-bit table replaces
   the per-bit exponent helper and cuts the 255/253-bit ladders to four
   squarings per nibble plus one multiply for each non-zero nibble. */
fun U256 secp_accel_fp_pow4(U256 a, U256 e) {
  var mark = heap_mark();
  var 1 table = alloc(16 * 32);
  var U256 t = a;
  st table + 32, t;
  var 1 d = 2;
  while d <=+ 15 {
    t = fp_mul(t, a);
    st table + d * 32, t;
    d = d + 1;
  }
  var U256 r = <1, 0, 0, 0>;
  var 1 win = 64;
  while win >+ 0 {
    win = win - 1;
    r = fp_sqr(r);
    r = fp_sqr(r);
    r = fp_sqr(r);
    r = fp_sqr(r);
    var 1 limb = win >>> 4;
    var 1 shift = (win & 15) * 4;
    var 1 ew = e.0;
    if limb == 1 { ew = e.1; }
    if limb == 2 { ew = e.2; }
    if limb == 3 { ew = e.3; }
    var 1 digit = (ew >>> shift) & 15;
    if digit != 0 {
      r = fp_mul(r, lds U256 (table + digit * 32));
    }
  }
  heap_release(mark);
  return r;
}

/* a ^ e mod p, square-and-multiply from the most significant set bit. */
fun U256 fp_pow(U256 a, U256 e) {
  var U256 r = <1, 0, 0, 0>;
  var started = 0;
  var i = 256;
  while i >+ 0 {
    i = i - 1;
    if started == 1 {
      r = fp_sqr(r);
    }
    var 1 bit = u256_bit(e, i);
    if bit == 1 {
      r = fp_mul(r, a);
      started = 1;
    }
  }
  return r;
}

/* a^(p-2) = a^-1 mod p (Fermat, the Lean form; 0 for a == 0). */
fun U256 fp_inv_fermat(U256 a) {
  return fp_pow(a, SECP_P_MINUS_2);
}

/* a^-1 mod m for odd m and 0 < a < m with gcd(a, m) = 1 (binary extended
   Euclid, HAC Algorithm 14.61 with modular halving); returns 0 for a == 0. */
fun U256 modinv_bin(U256 a, U256 m) {
  var 1 az = u256_is_zero(a);
  if az == 1 {
    return U256_ZERO;
  }
  var U256 u = a;
  var U256 v = m;
  var U256 x1 = <1, 0, 0, 0>;
  var U256 x2 = U256_ZERO;
  while true {
    if (u.1 | u.2 | u.3) == 0 {
      if u.0 == 1 { return x1; }
    }
    if (v.1 | v.2 | v.3) == 0 {
      if v.0 == 1 { return x2; }
    }
    while (u.0 & 1) == 0 {
      u = <(u.0 >>> 1) | (u.1 << 63), (u.1 >>> 1) | (u.2 << 63), (u.2 >>> 1) | (u.3 << 63), u.3 >>> 1>;
      x1 = mod_half(x1, m);
    }
    while (v.0 & 1) == 0 {
      v = <(v.0 >>> 1) | (v.1 << 63), (v.1 >>> 1) | (v.2 << 63), (v.2 >>> 1) | (v.3 << 63), v.3 >>> 1>;
      x2 = mod_half(x2, m);
    }
    var 1 ult = u256_lt(u, v);
    if ult == 0 {
      u = u256_sub(u, v);
      x1 = mod_sub(x1, x2, m);
    } else {
      v = u256_sub(v, u);
      x2 = mod_sub(x2, x1, m);
    }
  }
  return U256_ZERO;
}

/* x / 2 mod m for odd m, x < m: x >> 1 if x even, else (x + m) >> 1 (257-bit). */
fun U256 mod_half(U256 x, U256 m) {
  if (x.0 & 1) == 0 {
    return <(x.0 >>> 1) | (x.1 << 63), (x.1 >>> 1) | (x.2 << 63), (x.2 >>> 1) | (x.3 << 63), x.3 >>> 1>;
  }
  var {1,1,1,1,1} s = u256_add_carry(x, m);
  return <(s.0 >>> 1) | (s.1 << 63), (s.1 >>> 1) | (s.2 << 63), (s.2 >>> 1) | (s.3 << 63), (s.3 >>> 1) | (s.4 << 63)>;
}

/* (x - y) mod m for x, y < m. */
fun U256 mod_sub(U256 x, U256 y, U256 m) {
  var 1 lt = u256_lt(x, y);
  var U256 d = u256_sub(x, y);
  if lt == 1 {
    d = u256_add(d, m);
  }
  return d;
}

/* a^-1 mod p (0 for a == 0). */
fun U256 fp_inv(U256 a) {
  return secp_accel_fp_pow4(a, SECP_P_MINUS_2);
}

/* Square-root candidate a^((p+1)/4) mod p (Lean sqrtCand); the caller checks
   that its square is a. */
fun U256 fp_sqrt(U256 a) {
  return secp_accel_fp_pow4(a, SECP_SQRT_EXP);
}

/* ---------- scalar arithmetic mod n ---------- */

fun U256 fn_mul(U256 a, U256 b) {
  return secp_accel_modmul_n(a, b);
}

fun U256 fn_add(U256 a, U256 b) {
  return u256_addmod(a, b, SECP_N);
}

/* Scalar-modulus counterpart of secp_accel_fp_pow4. */
fun U256 secp_accel_fn_pow4(U256 a, U256 e) {
  var mark = heap_mark();
  var 1 table = alloc(16 * 32);
  var U256 t = a;
  st table + 32, t;
  var 1 d = 2;
  while d <=+ 15 {
    t = fn_mul(t, a);
    st table + d * 32, t;
    d = d + 1;
  }
  var U256 r = <1, 0, 0, 0>;
  var 1 win = 64;
  while win >+ 0 {
    win = win - 1;
    r = fn_mul(r, r);
    r = fn_mul(r, r);
    r = fn_mul(r, r);
    r = fn_mul(r, r);
    var 1 limb = win >>> 4;
    var 1 shift = (win & 15) * 4;
    var 1 ew = e.0;
    if limb == 1 { ew = e.1; }
    if limb == 2 { ew = e.2; }
    if limb == 3 { ew = e.3; }
    var 1 digit = (ew >>> shift) & 15;
    if digit != 0 {
      r = fn_mul(r, lds U256 (table + digit * 32));
    }
  }
  heap_release(mark);
  return r;
}

/* a ^ e mod n. */
fun U256 fn_pow(U256 a, U256 e) {
  var U256 r = <1, 0, 0, 0>;
  var started = 0;
  var i = 256;
  while i >+ 0 {
    i = i - 1;
    if started == 1 {
      r = fn_mul(r, r);
    }
    var 1 bit = u256_bit(e, i);
    if bit == 1 {
      r = fn_mul(r, a);
      started = 1;
    }
  }
  return r;
}

/* a^(n-2) = a^-1 mod n (Fermat, the Lean Accel.invMod r n form). */
fun U256 fn_inv_fermat(U256 a) {
  return fn_pow(a, SECP_N_MINUS_2);
}

/* a^-1 mod n (0 for a == 0). */
fun U256 fn_inv(U256 a) {
  return secp_accel_fn_pow4(a, SECP_N_MINUS_2);
}

/* ---------- Jacobian point arithmetic (points in memory, see header) ---------- */

fun 1 ec_set_infinity(1 pt) {
  st EC_X(pt), <1, 0, 0, 0>;
  st EC_Y(pt), <1, 0, 0, 0>;
  st EC_Z(pt), U256_ZERO;
  return 0;
}

fun 1 ec_set_affine(1 pt, U256 x, U256 y) {
  st EC_X(pt), x;
  st EC_Y(pt), y;
  st EC_Z(pt), <1, 0, 0, 0>;
  return 0;
}

fun 1 ec_is_infinity(1 pt) {
  var U256 z = lds U256 EC_Z(pt);
  return u256_is_zero(z);
}

/* Convert a finite Jacobian point to affine before handing it to a point CSR. */
fun 1 secp_accel_normalize(1 pt) {
  var U256 z = lds U256 EC_Z(pt);
  var U256 zi = fp_inv(z);
  var U256 zi2 = fp_sqr(zi);
  var U256 zi3 = fp_mul(zi2, zi);
  var U256 x = lds U256 EC_X(pt);
  var U256 y = lds U256 EC_Y(pt);
  x = fp_mul(x, zi2);
  y = fp_mul(y, zi3);
  ec_set_affine(pt, x, y);
  return 1;
}

/* pt = 2 * pt.  Lean: pointAdd P P is the identity when (y + y) % p == 0, i.e.
   y == 0 (the curve has no such point, but the case is kept), else curveDbl. */
fun 1 ec_double(1 pt) {
  var U256 z = lds U256 EC_Z(pt);
  var 1 zz = u256_is_zero(z);
  if zz == 1 {
    return 0;
  }
  var U256 y = lds U256 EC_Y(pt);
  var 1 yz = u256_is_zero(y);
  if yz == 1 {
    ec_set_infinity(pt);
    return 0;
  }
  var 1 affine = u256_eq(z, <1, 0, 0, 0>);
  if affine == 0 {
    secp_accel_normalize(pt);
  }
  @secpdbl(pt, 0, pt, 64);
  st EC_Z(pt), <1, 0, 0, 0>;
  return 0;
}

/* pt = pt + (ax, ay) with (ax, ay) an affine point (Z2 = 1; mixed addition).
   Same-x case split as Lean pointAdd on the cross-multiplied coordinates. */
fun 1 ec_add_affine(1 pt, U256 ax, U256 ay) {
  var U256 z1 = lds U256 EC_Z(pt);
  var 1 zz = u256_is_zero(z1);
  if zz == 1 {
    ec_set_affine(pt, ax, ay);
    return 0;
  }
  var 1 affine = u256_eq(z1, <1, 0, 0, 0>);
  if affine == 0 {
    secp_accel_normalize(pt);
  }
  var U256 x1 = lds U256 EC_X(pt);
  var U256 y1 = lds U256 EC_Y(pt);
  var 1 samex = u256_eq(x1, ax);
  if samex == 1 {
    var U256 ysum = fp_add(y1, ay);
    var 1 ysz = u256_is_zero(ysum);
    if ysz == 1 {
      ec_set_infinity(pt);
      return 0;
    }
    ec_double(pt);
    return 0;
  }
  secp256k1_init();
  var 1 blk = secp_accel_scratch + SECP_ACCEL_ADD;
  st blk + SECP_ACCEL_ADD_P1, x1;
  st blk + SECP_ACCEL_ADD_P1 + 32, y1;
  st blk + SECP_ACCEL_ADD_P2, ax;
  st blk + SECP_ACCEL_ADD_P2 + 32, ay;
  @secpadd(blk, 0, blk, SECP_ACCEL_ADD_SIZE);
  st EC_X(pt), lds U256 (blk + SECP_ACCEL_ADD_P1);
  st EC_Y(pt), lds U256 (blk + SECP_ACCEL_ADD_P1 + 32);
  st EC_Z(pt), <1, 0, 0, 0>;
  return 0;
}

/* pt = pt + q, both Jacobian (general addition, Lean pointAdd). */
fun 1 ec_add(1 pt, 1 q) {
  var U256 z2 = lds U256 EC_Z(q);
  var 1 z2z = u256_is_zero(z2);
  if z2z == 1 {
    return 0;
  }
  var U256 z1 = lds U256 EC_Z(pt);
  var 1 z1z = u256_is_zero(z1);
  if z1z == 1 {
    st EC_X(pt), lds U256 EC_X(q);
    st EC_Y(pt), lds U256 EC_Y(q);
    st EC_Z(pt), lds U256 EC_Z(q);
    return 0;
  }
  var U256 x1 = lds U256 EC_X(pt);
  var U256 y1 = lds U256 EC_Y(pt);
  var U256 x2 = lds U256 EC_X(q);
  var U256 y2 = lds U256 EC_Y(q);
  var U256 z1z1 = fp_sqr(z1);
  var U256 z2z2 = fp_sqr(z2);
  var U256 u1 = fp_mul(x1, z2z2);        /* U1 = X1 Z2^2 */
  var U256 u2 = fp_mul(x2, z1z1);        /* U2 = X2 Z1^2 */
  var U256 s1 = fp_mul(z2, z2z2);
  s1 = fp_mul(y1, s1);                   /* S1 = Y1 Z2^3 */
  var U256 s2 = fp_mul(z1, z1z1);
  s2 = fp_mul(y2, s2);                   /* S2 = Y2 Z1^3 */
  var 1 samex = u256_eq(u1, u2);
  if samex == 1 {
    var U256 ysum = fp_add(s1, s2);
    var 1 ysz = u256_is_zero(ysum);
    if ysz == 1 {
      ec_set_infinity(pt);
      return 0;
    }
    ec_double(pt);
    return 0;
  }
  var U256 h = fp_sub(u2, u1);
  var U256 rr = fp_sub(s2, s1);
  var U256 hh = fp_sqr(h);
  var U256 hhh = fp_mul(h, hh);
  var U256 v = fp_mul(u1, hh);
  var U256 x3 = fp_sqr(rr);
  x3 = fp_sub(x3, hhh);
  var U256 v2 = fp_add(v, v);
  x3 = fp_sub(x3, v2);
  var U256 y3 = fp_sub(v, x3);
  y3 = fp_mul(rr, y3);
  var U256 t = fp_mul(s1, hhh);
  y3 = fp_sub(y3, t);
  var U256 z3 = fp_mul(z1, z2);
  z3 = fp_mul(z3, h);
  st EC_X(pt), x3;
  st EC_Y(pt), y3;
  st EC_Z(pt), z3;
  return 0;
}

/* out = k * (ax, ay), MSB-first double-and-add (same group element as the
   Lean LSB-first scalarMul; k == 0 gives the identity). */
fun 1 ec_mul(1 out, U256 k, U256 ax, U256 ay) {
  ec_set_infinity(out);
  var 1 len = u256_bit_length(k);
  var i = len;
  while i >+ 0 {
    i = i - 1;
    ec_double(out);
    var 1 bit = u256_bit(k, i);
    if bit == 1 {
      ec_add_affine(out, ax, ay);
    }
  }
  return 0;
}

/* out = k1 * (ax, ay) + k2 * (bx, by) by a joint (Shamir) MSB-first
   double-and-add.  The four joint digits are 0, A, B, and A+B; using the
   precomputed A+B point turns the formerly two additions for digit 11 into
   one.  Same group element as pointAdd (scalarMul k1 A) (scalarMul k2 B) in
   the Lean. */
fun 1 ec_mul2(1 out, U256 k1, U256 ax, U256 ay, U256 k2, U256 bx, U256 by) {
  ec_set_infinity(out);
  var 1 len1 = u256_bit_length(k1);
  var 1 len2 = u256_bit_length(k2);
  var 1 i = max(len1, len2);
  if i == 0 {
    return 0;
  }
  var mark = heap_mark();
  /* A 2-bit joint window halves the ladder/control iterations.  The 16 affine
     entries cover d1*A + d2*B for d1,d2 in [0,3]; all CSR point operations
     return affine points, so the table can be consumed by mixed addition. */
  var 1 table = alloc(16 * EC_POINT_BYTES);
  ec_set_infinity(table);
  ec_set_affine(table + 4 * EC_POINT_BYTES, ax, ay);
  ec_set_affine(table + 8 * EC_POINT_BYTES, ax, ay);
  ec_double(table + 8 * EC_POINT_BYTES);
  ec_set_affine(table + 12 * EC_POINT_BYTES, ax, ay);
  ec_double(table + 12 * EC_POINT_BYTES);
  ec_add_affine(table + 12 * EC_POINT_BYTES, ax, ay);
  ec_set_affine(table + EC_POINT_BYTES, bx, by);
  ec_set_affine(table + 2 * EC_POINT_BYTES, bx, by);
  ec_double(table + 2 * EC_POINT_BYTES);
  ec_set_affine(table + 3 * EC_POINT_BYTES, bx, by);
  ec_double(table + 3 * EC_POINT_BYTES);
  ec_add_affine(table + 3 * EC_POINT_BYTES, bx, by);
  ec_set_affine(table + 5 * EC_POINT_BYTES,
                lds U256 EC_X(table + 4 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 4 * EC_POINT_BYTES));
  ec_add_affine(table + 5 * EC_POINT_BYTES,
                lds U256 EC_X(table + EC_POINT_BYTES),
                lds U256 EC_Y(table + EC_POINT_BYTES));
  ec_set_affine(table + 6 * EC_POINT_BYTES,
                lds U256 EC_X(table + 4 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 4 * EC_POINT_BYTES));
  ec_add_affine(table + 6 * EC_POINT_BYTES,
                lds U256 EC_X(table + 2 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 2 * EC_POINT_BYTES));
  ec_set_affine(table + 7 * EC_POINT_BYTES,
                lds U256 EC_X(table + 4 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 4 * EC_POINT_BYTES));
  ec_add_affine(table + 7 * EC_POINT_BYTES,
                lds U256 EC_X(table + 3 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 3 * EC_POINT_BYTES));
  ec_set_affine(table + 9 * EC_POINT_BYTES,
                lds U256 EC_X(table + 8 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 8 * EC_POINT_BYTES));
  ec_add_affine(table + 9 * EC_POINT_BYTES,
                lds U256 EC_X(table + EC_POINT_BYTES),
                lds U256 EC_Y(table + EC_POINT_BYTES));
  ec_set_affine(table + 10 * EC_POINT_BYTES,
                lds U256 EC_X(table + 8 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 8 * EC_POINT_BYTES));
  ec_add_affine(table + 10 * EC_POINT_BYTES,
                lds U256 EC_X(table + 2 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 2 * EC_POINT_BYTES));
  ec_set_affine(table + 11 * EC_POINT_BYTES,
                lds U256 EC_X(table + 8 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 8 * EC_POINT_BYTES));
  ec_add_affine(table + 11 * EC_POINT_BYTES,
                lds U256 EC_X(table + 3 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 3 * EC_POINT_BYTES));
  ec_set_affine(table + 13 * EC_POINT_BYTES,
                lds U256 EC_X(table + 12 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 12 * EC_POINT_BYTES));
  ec_add_affine(table + 13 * EC_POINT_BYTES,
                lds U256 EC_X(table + EC_POINT_BYTES),
                lds U256 EC_Y(table + EC_POINT_BYTES));
  ec_set_affine(table + 14 * EC_POINT_BYTES,
                lds U256 EC_X(table + 12 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 12 * EC_POINT_BYTES));
  ec_add_affine(table + 14 * EC_POINT_BYTES,
                lds U256 EC_X(table + 2 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 2 * EC_POINT_BYTES));
  ec_set_affine(table + 15 * EC_POINT_BYTES,
                lds U256 EC_X(table + 12 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 12 * EC_POINT_BYTES));
  ec_add_affine(table + 15 * EC_POINT_BYTES,
                lds U256 EC_X(table + 3 * EC_POINT_BYTES),
                lds U256 EC_Y(table + 3 * EC_POINT_BYTES));
  var 1 win = 128;
  while win >+ 0 {
    win = win - 1;
    ec_double(out);
    ec_double(out);
    var 1 pos = win * 2;
    var 1 high1 = u256_bit(k1, pos + 1);
    var 1 wd1 = high1 * 2;
    var 1 low1 = u256_bit(k1, pos);
    wd1 = wd1 + low1;
    var 1 high2 = u256_bit(k2, pos + 1);
    var 1 wd2 = high2 * 2;
    var 1 low2 = u256_bit(k2, pos);
    wd2 = wd2 + low2;
    var 1 digit = wd1 * 4 + wd2;
    if digit != 0 {
      var 1 entry = table + digit * EC_POINT_BYTES;
      var 1 entry_inf = ec_is_infinity(entry);
      if entry_inf == 0 {
        ec_add_affine(out, lds U256 EC_X(entry), lds U256 EC_Y(entry));
      }
    }
  }
  heap_release(mark);
  return 0;
}

/* Normalise pt to affine (X, Y, 1); returns 0 (and leaves pt) at infinity. */
fun 1 ec_to_affine(1 pt) {
  var U256 z = lds U256 EC_Z(pt);
  var 1 zz = u256_is_zero(z);
  if zz == 1 {
    return 0;
  }
  var U256 zi = fp_inv(z);
  var U256 zi2 = fp_sqr(zi);
  var U256 zi3 = fp_mul(zi2, zi);
  var U256 x = lds U256 EC_X(pt);
  var U256 y = lds U256 EC_Y(pt);
  x = fp_mul(x, zi2);
  y = fp_mul(y, zi3);
  ec_set_affine(pt, x, y);
  return 1;
}

/* 1 if (x, y) satisfies y^2 == x^3 + 7 (Lean onCurve). */
fun 1 ec_on_curve(U256 x, U256 y) {
  var U256 l = fp_sqr(y);
  var U256 r = fp_sqr(x);
  r = fp_mul(r, x);
  r = fp_add(r, SECP_B);
  return u256_eq(l, r);
}

/* ---------- recovery ---------- */

/* Lean decompressR: writes the affine R at out (96-byte point); returns 1, or
   0 on xOutOfRange / xNotSquare. */
fun 1 secp256k1_decompress_r(U256 r, 1 recid, 1 out) {
  var U256 x = r;
  if ((recid >>> 1) & 1) == 1 {
    var {1,1,1,1,1} xs = u256_add_carry(r, SECP_N);
    if xs.4 == 1 {
      return 0;                              /* r + n >= 2^256 > p */
    }
    x = <xs.0, xs.1, xs.2, xs.3>;
  }
  var 1 xlt = u256_lt(x, SECP_P);
  if xlt == 0 {
    return 0;                                /* xOutOfRange */
  }
  var U256 rhs = fp_sqr(x);
  rhs = fp_mul(rhs, x);
  rhs = fp_add(rhs, SECP_B);                 /* x^3 + 7 */
  var U256 y0 = fp_sqrt(rhs);
  var U256 chk = fp_sqr(y0);
  var 1 sq = u256_eq(chk, rhs);
  if sq == 0 {
    return 0;                                /* xNotSquare */
  }
  var U256 y = y0;
  if (y0.0 & 1) != (recid & 1) {
    y = fp_neg(y0);
  }
  ec_set_affine(out, x, y);
  return 1;
}

/* Lean recover.  msg_hash: 32 big-endian bytes (e); r, s: signature scalars;
   recid: bit 0 = parity of R.y, bit 1 selects x = r + n.  On success writes
   the 64-byte uncompressed point (BE x || BE y) at out and returns 1; returns
   0 on rOutOfRange / sOutOfRange / xOutOfRange / xNotSquare / atInfinity. */
fun 1 secp256k1_recover(1 msg_hash, U256 r, U256 s, 1 recid, 1 out) {
  var 1 rz = u256_is_zero(r);
  if rz == 1 { return 0; }
  var 1 rlt = u256_lt(r, SECP_N);
  if rlt == 0 { return 0; }
  var 1 sz = u256_is_zero(s);
  if sz == 1 { return 0; }
  var 1 slt = u256_lt(s, SECP_N);
  if slt == 0 { return 0; }
  var mark = heap_mark();
  var pq = alloc(EC_POINT_BYTES);            /* Q = u1 G + u2 R */
  var pr = alloc(EC_POINT_BYTES);            /* R */
  var 1 okr = secp256k1_decompress_r(r, recid, pr);
  if okr == 0 {
    heap_release(mark);
    return 0;
  }
  var U256 rx = lds U256 EC_X(pr);
  var U256 ry = lds U256 EC_Y(pr);
  /* e mod n: e < 2^256 < 2n, one conditional subtraction (Lean reduce_once_eq_mod) */
  var U256 e = u256_from_be(msg_hash, 32);
  var 1 elt = u256_lt(e, SECP_N);
  if elt == 0 {
    e = u256_sub(e, SECP_N);
  }
  var U256 rinv = fn_inv(r);
  var U256 nege = U256_ZERO;                 /* (n - e mod n) mod n */
  var 1 ez = u256_is_zero(e);
  if ez == 0 {
    nege = u256_sub(SECP_N, e);
  }
  var U256 u1 = fn_mul(nege, rinv);
  var U256 u2 = fn_mul(s, rinv);
#ifdef SECP_SEPARATE_MULS
  ec_mul(pq, u1, SECP_GX, SECP_GY);
  ec_mul(pr, u2, rx, ry);
  ec_add(pq, pr);
#else
  ec_mul2(pq, u1, SECP_GX, SECP_GY, u2, rx, ry);
#endif
  var 1 ok = ec_to_affine(pq);
  if ok == 1 {
    var U256 qx = lds U256 EC_X(pq);
    var U256 qy = lds U256 EC_Y(pq);
    u256_to_be32(qx, out);
    u256_to_be32(qy, out + 32);
  }
  heap_release(mark);
  return ok;
}

/* Lean addressOfPoint: keccak256 of the 64-byte point at pub64, last 20 bytes
   to out20.  Requires keccak_init() before entry. */
fun 1 secp256k1_address_of_point(1 pub64, 1 out20) {
  var mark = heap_mark();
  var h = alloc(32);
  keccak256(pub64, 64, h);
  memcpy(out20, h + 12, 20);
  heap_release(mark);
  return 0;
}

/* Lean ecrecoverAddress (the ECRECOVER precompile): v must be 27 or 28, recid
   = v - 27; on success writes the 20-byte address at out20 and returns 1. */
fun 1 secp256k1_ecrecover(1 msg_hash, 1 v, U256 r, U256 s, 1 out20) {
  if v != 27 {
    if v != 28 {
      return 0;
    }
  }
  var mark = heap_mark();
  var pub = alloc(64);
  var 1 ok = secp256k1_recover(msg_hash, r, s, v - 27, pub);
  if ok == 1 {
    secp256k1_address_of_point(pub, out20);
  }
  heap_release(mark);
  return ok;
}
