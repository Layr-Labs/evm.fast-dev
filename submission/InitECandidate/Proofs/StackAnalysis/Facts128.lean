theorem frame128_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized128.2.1 optimized128.2.2 = frame128 := by cbv
theorem slim128_eq : WordDepth.Executable.slim optimized128.2.2 = slim128 := by cbv
theorem frameEntry128_eq : frameEntry optimized128 = (128, frame128) := by
  unfold frameEntry
  rw [frame128_eq]
  rfl
theorem slimEntry128_eq : slimEntry optimized128 = (128, 7, slim128) := by
  unfold slimEntry
  rw [slim128_eq]
  rfl
#print axioms frame128_eq
#print axioms slim128_eq
end InitECandidate.Proofs.StackAnalysis
