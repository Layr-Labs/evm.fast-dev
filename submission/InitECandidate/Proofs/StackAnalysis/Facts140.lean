theorem frame140_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized140.2.1 optimized140.2.2 = frame140 := by cbv
theorem slim140_eq : WordDepth.Executable.slim optimized140.2.2 = slim140 := by cbv
theorem frameEntry140_eq : frameEntry optimized140 = (140, frame140) := by
  unfold frameEntry
  rw [frame140_eq]
  rfl
theorem slimEntry140_eq : slimEntry optimized140 = (140, 9, slim140) := by
  unfold slimEntry
  rw [slim140_eq]
  rfl
