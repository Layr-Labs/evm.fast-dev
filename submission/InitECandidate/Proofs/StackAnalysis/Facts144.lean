theorem frame144_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized144.2.1 optimized144.2.2 = frame144 := by cbv
theorem slim144_eq : WordDepth.Executable.slim optimized144.2.2 = slim144 := by cbv
theorem frameEntry144_eq : frameEntry optimized144 = (144, frame144) := by
  unfold frameEntry
  rw [frame144_eq]
  rfl
theorem slimEntry144_eq : slimEntry optimized144 = (144, 6, slim144) := by
  unfold slimEntry
  rw [slim144_eq]
  rfl
#print axioms frame144_eq
#print axioms slim144_eq
end InitECandidate.Proofs.StackAnalysis
