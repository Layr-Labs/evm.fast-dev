theorem frame146_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized146.2.1 optimized146.2.2 = frame146 := by cbv
theorem slim146_eq : WordDepth.Executable.slim optimized146.2.2 = slim146 := by cbv
theorem frameEntry146_eq : frameEntry optimized146 = (146, frame146) := by
  unfold frameEntry
  rw [frame146_eq]
  rfl
theorem slimEntry146_eq : slimEntry optimized146 = (146, 3, slim146) := by
  unfold slimEntry
  rw [slim146_eq]
  rfl
#print axioms frame146_eq
#print axioms slim146_eq
end InitECandidate.Proofs.StackAnalysis
