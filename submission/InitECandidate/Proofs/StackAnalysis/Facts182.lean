theorem frame182_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized182.2.1 optimized182.2.2 = frame182 := by cbv
theorem slim182_eq : WordDepth.Executable.slim optimized182.2.2 = slim182 := by cbv
theorem frameEntry182_eq : frameEntry optimized182 = (182, frame182) := by
  unfold frameEntry
  rw [frame182_eq]
  rfl
theorem slimEntry182_eq : slimEntry optimized182 = (182, 3, slim182) := by
  unfold slimEntry
  rw [slim182_eq]
  rfl
