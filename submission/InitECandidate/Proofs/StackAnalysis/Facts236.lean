theorem frame236_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized236.2.1 optimized236.2.2 = frame236 := by cbv
theorem slim236_eq : WordDepth.Executable.slim optimized236.2.2 = slim236 := by cbv
theorem frameEntry236_eq : frameEntry optimized236 = (236, frame236) := by
  unfold frameEntry
  rw [frame236_eq]
  rfl
theorem slimEntry236_eq : slimEntry optimized236 = (236, 4, slim236) := by
  unfold slimEntry
  rw [slim236_eq]
  rfl
#print axioms frame236_eq
