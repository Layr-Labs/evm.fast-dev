theorem frame255_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized255.2.1 optimized255.2.2 = frame255 := by cbv
theorem slim255_eq : WordDepth.Executable.slim optimized255.2.2 = slim255 := by cbv
theorem frameEntry255_eq : frameEntry optimized255 = (255, frame255) := by
  unfold frameEntry
  rw [frame255_eq]
  rfl
theorem slimEntry255_eq : slimEntry optimized255 = (255, 3, slim255) := by
  unfold slimEntry
  rw [slim255_eq]
  rfl
#print axioms frame255_eq
