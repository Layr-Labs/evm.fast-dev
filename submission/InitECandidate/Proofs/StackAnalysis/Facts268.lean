theorem frame268_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized268.2.1 optimized268.2.2 = frame268 := by cbv
theorem slim268_eq : WordDepth.Executable.slim optimized268.2.2 = slim268 := by cbv
theorem frameEntry268_eq : frameEntry optimized268 = (268, frame268) := by
  unfold frameEntry
  rw [frame268_eq]
  rfl
theorem slimEntry268_eq : slimEntry optimized268 = (268, 6, slim268) := by
  unfold slimEntry
  rw [slim268_eq]
  rfl
#print axioms frame268_eq
#print axioms slim268_eq
end InitECandidate.Proofs.StackAnalysis
