theorem frame314_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized314.2.1 optimized314.2.2 = frame314 := by cbv
theorem slim314_eq : WordDepth.Executable.slim optimized314.2.2 = slim314 := by cbv
theorem frameEntry314_eq : frameEntry optimized314 = (314, frame314) := by
  unfold frameEntry
  rw [frame314_eq]
  rfl
theorem slimEntry314_eq : slimEntry optimized314 = (314, 9, slim314) := by
  unfold slimEntry
  rw [slim314_eq]
  rfl
#print axioms frame314_eq
