theorem frame320_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized320.2.1 optimized320.2.2 = frame320 := by cbv
theorem slim320_eq : WordDepth.Executable.slim optimized320.2.2 = slim320 := by cbv
theorem frameEntry320_eq : frameEntry optimized320 = (320, frame320) := by
  unfold frameEntry
  rw [frame320_eq]
  rfl
theorem slimEntry320_eq : slimEntry optimized320 = (320, 6, slim320) := by
  unfold slimEntry
  rw [slim320_eq]
  rfl
#print axioms frame320_eq
#print axioms slim320_eq
end InitECandidate.Proofs.StackAnalysis
