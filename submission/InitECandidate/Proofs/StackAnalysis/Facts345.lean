theorem frame345_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized345.2.1 optimized345.2.2 = frame345 := by cbv
theorem slim345_eq : WordDepth.Executable.slim optimized345.2.2 = slim345 := by cbv
theorem frameEntry345_eq : frameEntry optimized345 = (345, frame345) := by
  unfold frameEntry
  rw [frame345_eq]
  rfl
theorem slimEntry345_eq : slimEntry optimized345 = (345, 3, slim345) := by
  unfold slimEntry
  rw [slim345_eq]
