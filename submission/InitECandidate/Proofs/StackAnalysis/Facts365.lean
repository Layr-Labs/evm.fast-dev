theorem frame365_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized365.2.1 optimized365.2.2 = frame365 := by cbv
theorem slim365_eq : WordDepth.Executable.slim optimized365.2.2 = slim365 := by cbv
theorem frameEntry365_eq : frameEntry optimized365 = (365, frame365) := by
  unfold frameEntry
  rw [frame365_eq]
  rfl
theorem slimEntry365_eq : slimEntry optimized365 = (365, 2, slim365) := by
  unfold slimEntry
  rw [slim365_eq]
  rfl
#print axioms frame365_eq
#print axioms slim365_eq
end InitECandidate.Proofs.StackAnalysis
