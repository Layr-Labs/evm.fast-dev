theorem frame381_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized381.2.1 optimized381.2.2 = frame381 := by cbv
theorem slim381_eq : WordDepth.Executable.slim optimized381.2.2 = slim381 := by cbv
theorem frameEntry381_eq : frameEntry optimized381 = (381, frame381) := by
  unfold frameEntry
  rw [frame381_eq]
  rfl
theorem slimEntry381_eq : slimEntry optimized381 = (381, 4, slim381) := by
  unfold slimEntry
  rw [slim381_eq]
  rfl
#print axioms frame381_eq
#print axioms slim381_eq
end InitECandidate.Proofs.StackAnalysis
