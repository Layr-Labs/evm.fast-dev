                          Flapjack.Spt.ln))
                      Flapjack.Spt.ln,
                  snd := Flapjack.Spt.ln },
              snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 402, snd := 6 } } } })
      (Option.some 190) List.nil
      (Option.some { fst := 2, snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 402, snd := 7 } } })))
theorem frame402_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized402.2.1 optimized402.2.2 = frame402 := by cbv
theorem slim402_eq : WordDepth.Executable.slim optimized402.2.2 = slim402 := by cbv
theorem frameEntry402_eq : frameEntry optimized402 = (402, frame402) := by
  unfold frameEntry
  rw [frame402_eq]
  rfl
theorem slimEntry402_eq : slimEntry optimized402 = (402, 2, slim402) := by
  unfold slimEntry
  rw [slim402_eq]
  rfl
#print axioms frame402_eq
#print axioms slim402_eq
end InitECandidate.Proofs.StackAnalysis
