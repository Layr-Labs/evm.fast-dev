theorem frame410_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized410.2.1 optimized410.2.2 = frame410 := by cbv
theorem slim410_eq : WordDepth.Executable.slim optimized410.2.2 = slim410 := by cbv
theorem frameEntry410_eq : frameEntry optimized410 = (410, frame410) := by
  unfold frameEntry
  rw [frame410_eq]
  rfl
theorem slimEntry410_eq : slimEntry optimized410 = (410, 3, slim410) := by
  unfold slimEntry
  rw [slim410_eq]
  rfl
