theorem frame416_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized416.2.1 optimized416.2.2 = frame416 := by cbv
theorem slim416_eq : WordDepth.Executable.slim optimized416.2.2 = slim416 := by cbv
theorem frameEntry416_eq : frameEntry optimized416 = (416, frame416) := by
