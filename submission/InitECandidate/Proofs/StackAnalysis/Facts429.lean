theorem frame429_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized429.2.1 optimized429.2.2 = frame429 := by cbv
theorem slim429_eq : WordDepth.Executable.slim optimized429.2.2 = slim429 := by cbv
theorem frameEntry429_eq : frameEntry optimized429 = (429, frame429) := by
  unfold frameEntry
  rw [frame429_eq]
  rfl
theorem slimEntry429_eq : slimEntry optimized429 = (429, 6, slim429) := by
  unfold slimEntry
  rw [slim429_eq]
  rfl
