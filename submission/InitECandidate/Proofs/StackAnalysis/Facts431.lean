theorem frame431_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized431.2.1 optimized431.2.2 = frame431 := by cbv
theorem slim431_eq : WordDepth.Executable.slim optimized431.2.2 = slim431 := by cbv
theorem frameEntry431_eq : frameEntry optimized431 = (431, frame431) := by
  unfold frameEntry
  rw [frame431_eq]
  rfl
theorem slimEntry431_eq : slimEntry optimized431 = (431, 6, slim431) := by
  unfold slimEntry
