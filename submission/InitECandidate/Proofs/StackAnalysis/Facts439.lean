theorem frame439_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized439.2.1 optimized439.2.2 = frame439 := by cbv
theorem slim439_eq : WordDepth.Executable.slim optimized439.2.2 = slim439 := by cbv
theorem frameEntry439_eq : frameEntry optimized439 = (439, frame439) := by
  unfold frameEntry
  rw [frame439_eq]
  rfl
theorem slimEntry439_eq : slimEntry optimized439 = (439, 3, slim439) := by
  unfold slimEntry
  rw [slim439_eq]
  rfl
#print axioms frame439_eq
