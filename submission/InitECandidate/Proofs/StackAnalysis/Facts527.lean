theorem frame527_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized527.2.1 optimized527.2.2 = frame527 := by cbv
theorem slim527_eq : WordDepth.Executable.slim optimized527.2.2 = slim527 := by cbv
theorem frameEntry527_eq : frameEntry optimized527 = (527, frame527) := by
  unfold frameEntry
  rw [frame527_eq]
  rfl
theorem slimEntry527_eq : slimEntry optimized527 = (527, 1, slim527) := by
  unfold slimEntry
  rw [slim527_eq]
  rfl
#print axioms frame527_eq
#print axioms slim527_eq
end InitECandidate.Proofs.StackAnalysis
