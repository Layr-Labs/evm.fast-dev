theorem frame532_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized532.2.1 optimized532.2.2 = frame532 := by cbv
theorem slim532_eq : WordDepth.Executable.slim optimized532.2.2 = slim532 := by cbv
theorem frameEntry532_eq : frameEntry optimized532 = (532, frame532) := by
  unfold frameEntry
  rw [frame532_eq]
  rfl
theorem slimEntry532_eq : slimEntry optimized532 = (532, 1, slim532) := by
  unfold slimEntry
  rw [slim532_eq]
  rfl
