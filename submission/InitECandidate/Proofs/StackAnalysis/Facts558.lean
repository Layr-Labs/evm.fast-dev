theorem frame558_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized558.2.1 optimized558.2.2 = frame558 := by cbv
theorem slim558_eq : WordDepth.Executable.slim optimized558.2.2 = slim558 := by cbv
theorem frameEntry558_eq : frameEntry optimized558 = (558, frame558) := by
  unfold frameEntry
  rw [frame558_eq]
  rfl
theorem slimEntry558_eq : slimEntry optimized558 = (558, 1, slim558) := by
  unfold slimEntry
  rw [slim558_eq]
  rfl
