theorem frame573_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized573.2.1 optimized573.2.2 = frame573 := by cbv
theorem slim573_eq : WordDepth.Executable.slim optimized573.2.2 = slim573 := by cbv
theorem frameEntry573_eq : frameEntry optimized573 = (573, frame573) := by
  unfold frameEntry
  rw [frame573_eq]
  rfl
theorem slimEntry573_eq : slimEntry optimized573 = (573, 1, slim573) := by
  unfold slimEntry
  rw [slim573_eq]
  rfl
#print axioms frame573_eq
