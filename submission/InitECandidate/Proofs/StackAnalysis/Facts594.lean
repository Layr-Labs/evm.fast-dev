theorem frame594_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized594.2.1 optimized594.2.2 = frame594 := by cbv
theorem slim594_eq : WordDepth.Executable.slim optimized594.2.2 = slim594 := by cbv
theorem frameEntry594_eq : frameEntry optimized594 = (594, frame594) := by
  unfold frameEntry
  rw [frame594_eq]
  rfl
theorem slimEntry594_eq : slimEntry optimized594 = (594, 3, slim594) := by
  unfold slimEntry
  rw [slim594_eq]
  rfl
#print axioms frame594_eq
#print axioms slim594_eq
end InitECandidate.Proofs.StackAnalysis
