theorem frame658_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized658.2.1 optimized658.2.2 = frame658 := by cbv
theorem slim658_eq : WordDepth.Executable.slim optimized658.2.2 = slim658 := by cbv
theorem frameEntry658_eq : frameEntry optimized658 = (658, frame658) := by
  unfold frameEntry
  rw [frame658_eq]
  rfl
theorem slimEntry658_eq : slimEntry optimized658 = (658, 1, slim658) := by
  unfold slimEntry
  rw [slim658_eq]
  rfl
#print axioms frame658_eq
#print axioms slim658_eq
end InitECandidate.Proofs.StackAnalysis
