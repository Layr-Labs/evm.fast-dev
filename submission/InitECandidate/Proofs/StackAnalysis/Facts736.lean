theorem frame736_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized736.2.1 optimized736.2.2 = frame736 := by cbv
theorem slim736_eq : WordDepth.Executable.slim optimized736.2.2 = slim736 := by cbv
theorem frameEntry736_eq : frameEntry optimized736 = (736, frame736) := by
  unfold frameEntry
  rw [frame736_eq]
  rfl
theorem slimEntry736_eq : slimEntry optimized736 = (736, 3, slim736) := by
  unfold slimEntry
  rw [slim736_eq]
  rfl
#print axioms frame736_eq
#print axioms slim736_eq
