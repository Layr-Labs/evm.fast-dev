theorem frame750_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized750.2.1 optimized750.2.2 = frame750 := by cbv
theorem slim750_eq : WordDepth.Executable.slim optimized750.2.2 = slim750 := by cbv
theorem frameEntry750_eq : frameEntry optimized750 = (750, frame750) := by
  unfold frameEntry
  rw [frame750_eq]
  rfl
theorem slimEntry750_eq : slimEntry optimized750 = (750, 4, slim750) := by
  unfold slimEntry
  rw [slim750_eq]
  rfl
#print axioms frame750_eq
#print axioms slim750_eq
end InitECandidate.Proofs.StackAnalysis
