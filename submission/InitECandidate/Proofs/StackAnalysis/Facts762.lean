            snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 762, snd := 2 } } } })
    (Option.some 747) List.nil
    (Option.some { fst := 2, snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 762, snd := 3 } } }))
