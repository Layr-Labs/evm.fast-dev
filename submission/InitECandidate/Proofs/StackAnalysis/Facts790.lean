theorem frame790_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized790.2.1 optimized790.2.2 = frame790 := by cbv
theorem slim790_eq : WordDepth.Executable.slim optimized790.2.2 = slim790 := by cbv
theorem frameEntry790_eq : frameEntry optimized790 = (790, frame790) := by
  unfold frameEntry
  rw [frame790_eq]
  rfl
theorem slimEntry790_eq : slimEntry optimized790 = (790, 2, slim790) := by
  unfold slimEntry
  rw [slim790_eq]
  rfl
#print axioms frame790_eq
