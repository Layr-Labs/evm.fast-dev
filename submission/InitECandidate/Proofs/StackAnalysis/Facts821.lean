                    snd := Flapjack.Spt.ln },
                snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 821, snd := 8 } } } })
        (Option.some 777) List.nil
        (Option.some { fst := 2, snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 821, snd := 9 } } }))))
theorem frame821_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized821.2.1 optimized821.2.2 = frame821 := by cbv
theorem slim821_eq : WordDepth.Executable.slim optimized821.2.2 = slim821 := by cbv
theorem frameEntry821_eq : frameEntry optimized821 = (821, frame821) := by
  unfold frameEntry
  rw [frame821_eq]
  rfl
theorem slimEntry821_eq : slimEntry optimized821 = (821, 1, slim821) := by
  unfold slimEntry
  rw [slim821_eq]
  rfl
#print axioms frame821_eq
#print axioms slim821_eq
end InitECandidate.Proofs.StackAnalysis
