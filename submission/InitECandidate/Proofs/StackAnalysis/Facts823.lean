theorem frame823_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized823.2.1 optimized823.2.2 = frame823 := by cbv
theorem slim823_eq : WordDepth.Executable.slim optimized823.2.2 = slim823 := by cbv
theorem frameEntry823_eq : frameEntry optimized823 = (823, frame823) := by
  unfold frameEntry
  rw [frame823_eq]
  rfl
theorem slimEntry823_eq : slimEntry optimized823 = (823, 1, slim823) := by
  unfold slimEntry
  rw [slim823_eq]
  rfl
