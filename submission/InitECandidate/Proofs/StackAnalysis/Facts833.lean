theorem frame833_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized833.2.1 optimized833.2.2 = frame833 := by cbv
theorem slim833_eq : WordDepth.Executable.slim optimized833.2.2 = slim833 := by cbv
theorem frameEntry833_eq : frameEntry optimized833 = (833, frame833) := by
  unfold frameEntry
  rw [frame833_eq]
  rfl
theorem slimEntry833_eq : slimEntry optimized833 = (833, 1, slim833) := by
  unfold slimEntry
  rw [slim833_eq]
  rfl
#print axioms frame833_eq
#print axioms slim833_eq
end InitECandidate.Proofs.StackAnalysis
