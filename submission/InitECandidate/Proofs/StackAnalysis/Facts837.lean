theorem frame837_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized837.2.1 optimized837.2.2 = frame837 := by cbv
theorem slim837_eq : WordDepth.Executable.slim optimized837.2.2 = slim837 := by cbv
theorem frameEntry837_eq : frameEntry optimized837 = (837, frame837) := by
