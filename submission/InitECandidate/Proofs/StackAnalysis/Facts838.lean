theorem frame838_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized838.2.1 optimized838.2.2 = frame838 := by cbv
theorem slim838_eq : WordDepth.Executable.slim optimized838.2.2 = slim838 := by cbv
theorem frameEntry838_eq : frameEntry optimized838 = (838, frame838) := by
  unfold frameEntry
  rw [frame838_eq]
  rfl
theorem slimEntry838_eq : slimEntry optimized838 = (838, 1, slim838) := by
  unfold slimEntry
  rw [slim838_eq]
  rfl
#print axioms frame838_eq
#print axioms slim838_eq
end InitECandidate.Proofs.StackAnalysis
