theorem frame850_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized850.2.1 optimized850.2.2 = frame850 := by cbv
theorem slim850_eq : WordDepth.Executable.slim optimized850.2.2 = slim850 := by cbv
theorem frameEntry850_eq : frameEntry optimized850 = (850, frame850) := by
  unfold frameEntry
  rw [frame850_eq]
  rfl
theorem slimEntry850_eq : slimEntry optimized850 = (850, 4, slim850) := by
  unfold slimEntry
  rw [slim850_eq]
  rfl
#print axioms frame850_eq
#print axioms slim850_eq
end InitECandidate.Proofs.StackAnalysis
