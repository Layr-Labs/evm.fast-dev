theorem frame851_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized851.2.1 optimized851.2.2 = frame851 := by cbv
theorem slim851_eq : WordDepth.Executable.slim optimized851.2.2 = slim851 := by cbv
theorem frameEntry851_eq : frameEntry optimized851 = (851, frame851) := by
  unfold frameEntry
  rw [frame851_eq]
  rfl
theorem slimEntry851_eq : slimEntry optimized851 = (851, 3, slim851) := by
  unfold slimEntry
  rw [slim851_eq]
  rfl
#print axioms frame851_eq
#print axioms slim851_eq
end InitECandidate.Proofs.StackAnalysis
