    (Option.some 77) List.nil
    (Option.some { fst := 2, snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 878, snd := 5 } } }))
theorem frame878_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized878.2.1 optimized878.2.2 = frame878 := by cbv
theorem slim878_eq : WordDepth.Executable.slim optimized878.2.2 = slim878 := by cbv
theorem frameEntry878_eq : frameEntry optimized878 = (878, frame878) := by
  unfold frameEntry
  rw [frame878_eq]
  rfl
theorem slimEntry878_eq : slimEntry optimized878 = (878, 4, slim878) := by
  unfold slimEntry
  rw [slim878_eq]
  rfl
#print axioms frame878_eq
#print axioms slim878_eq
end InitECandidate.Proofs.StackAnalysis
