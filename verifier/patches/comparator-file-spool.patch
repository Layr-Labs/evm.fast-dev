diff --git a/tests/soundness_replay.lean b/tests/soundness_replay.lean
new file mode 100644
index 0000000..95d7685
--- /dev/null
+++ b/tests/soundness_replay.lean
@@ -0,0 +1,556 @@
+import Lean
+import Comparator.ParallelReplay
+
+open Lean
+
+private def expectReject (label : String) (substr : String) (action : IO Unit) : IO Unit := do
+  try
+    action
+    throw <| IO.userError s!"[{label}] expected rejection containing '{substr}', but checkParallel accepted"
+  catch e =>
+    let msg := e.toString
+    if ((msg.splitOn substr).length < 2) then
+      throw <| IO.userError s!"[{label}] rejected with unexpected error:\n{msg}\nexpected substring: '{substr}'"
+
+private def expectAccept (label : String) (action : IO Unit) : IO Unit := do
+  try
+    action
+  catch e =>
+    throw <| IO.userError s!"[{label}] expected acceptance, got error:\n{e}"
+
+private def mkMap (entries : List (Name × ConstantInfo)) : Std.HashMap Name ConstantInfo :=
+  entries.foldl (init := {}) fun m (k, v) => m.insert k v
+
+def main : IO Unit := do
+  let emptyEnv ← mkEmptyEnvironment
+
+  -- 1. Forged constructor type in ConstantInfo map
+  let indName := `ForgedInd
+  let ctorName := `ForgedInd.mk
+  let indInfo : ConstantInfo := .inductInfo {
+    name := indName
+    levelParams := []
+    type := .sort .zero
+    numParams := 0
+    numIndices := 0
+    all := [indName]
+    ctors := [ctorName]
+    numNested := 0
+    isRec := false
+    isUnsafe := false
+    isReflexive := false
+  }
+  let forgedCtorInfo : ConstantInfo := .ctorInfo {
+    name := ctorName
+    levelParams := []
+    type := .sort (.succ .zero) -- forged: Type instead of ForgedInd
+    induct := indName
+    cidx := 0
+    numParams := 0
+    numFields := 0
+    isUnsafe := false
+  }
+  expectReject "forged_ctor_type" "invalid return type" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(indName, indInfo), (ctorName, forgedCtorInfo)]) emptyEnv
+
+  -- 2. Forged constructor cidx metadata (kernel builds cidx := 0, map claims cidx := 1)
+  let validCtorWithBadIdx : ConstantInfo := .ctorInfo {
+    name := ctorName
+    levelParams := []
+    type := .const indName []
+    induct := indName
+    cidx := 1
+    numParams := 0
+    numFields := 0
+    isUnsafe := false
+  }
+  expectReject "forged_ctor_metadata" "Invalid constructor" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(indName, indInfo), (ctorName, validCtorWithBadIdx)]) emptyEnv
+
+  -- 3. Forged recursor rule (RHS claims True when motive is arbitrary)
+  let validCtorInfo : ConstantInfo := .ctorInfo {
+    name := ctorName
+    levelParams := []
+    type := .const indName []
+    induct := indName
+    cidx := 0
+    numParams := 0
+    numFields := 0
+    isUnsafe := false
+  }
+  let recName := `ForgedInd.rec
+  let forgedRecInfo : ConstantInfo := .recInfo {
+    name := recName
+    levelParams := [`u]
+    type := .sort .zero -- forged recursor type
+    all := [indName]
+    numParams := 0
+    numIndices := 0
+    numMotives := 1
+    numMinors := 1
+    rules := []
+    k := true
+    isUnsafe := false
+  }
+  expectReject "forged_recursor" "Invalid recursor" do
+    Comparator.ParallelReplay.checkParallel 2
+      (mkMap [(indName, indInfo), (ctorName, validCtorInfo), (recName, forgedRecInfo)]) emptyEnv
+
+  -- 4. Forged inductive metadata (isReflexive := true vs kernel false, or numNested mismatch)
+  let forgedIndMeta : ConstantInfo := .inductInfo {
+    name := indName
+    levelParams := []
+    type := .sort .zero
+    numParams := 0
+    numIndices := 0
+    all := [indName]
+    ctors := [ctorName]
+    numNested := 7 -- forged metadata
+    isRec := false
+    isUnsafe := false
+    isReflexive := false
+  }
+  expectReject "forged_inductive_metadata" "Invalid inductive" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(indName, forgedIndMeta), (ctorName, validCtorInfo)]) emptyEnv
+
+  -- 5. Forged quotient ConstantInfo (extract authentic Eq / Eq.refl from elaborated environment)
+  let initEnv ← importModules #[{ module := `Init.Core }] {}
+  let eqInd := (initEnv.find? ``Eq).get!
+  let eqRefl := (initEnv.find? ``Eq.refl).get!
+  let forgedQuot : ConstantInfo := .quotInfo {
+    name := ``Quot
+    levelParams := []
+    type := .sort .zero -- forged type
+    kind := .type
+  }
+  expectReject "forged_quotient" "Invalid quotient" do
+    Comparator.ParallelReplay.checkParallel 2
+      (mkMap [(``Eq, eqInd), (``Eq.refl, eqRefl), (``Quot, forgedQuot)]) emptyEnv
+
+  -- 6. Unexpected quotient declaration name
+  let fakeQuot : ConstantInfo := .quotInfo {
+    name := `FakeQuot
+    levelParams := []
+    type := .sort .zero
+    kind := .type
+  }
+  expectReject "unexpected_quotient_name" "unexpected quotient declaration" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(`FakeQuot, fakeQuot)]) emptyEnv
+
+  -- 7. Key/name mismatch in HashMap
+  let mismatchThm : ConstantInfo := .thmInfo {
+    name := `realName
+    levelParams := []
+    type := .sort .zero
+    value := .sort .zero
+    all := [`realName]
+  }
+  expectReject "key_name_mismatch" "mismatched constant name" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(`wrongKey, mismatchThm)]) emptyEnv
+
+  -- 8. Struct projection dependency ordering (.proj without explicit .const of ProjBox in value)
+  let boxName := `ProjBox
+  let boxMk := `ProjBox.mk
+  let boxInd : ConstantInfo := .inductInfo {
+    name := boxName
+    levelParams := []
+    type := .sort (.succ .zero)
+    numParams := 0
+    numIndices := 0
+    all := [boxName]
+    ctors := [boxMk]
+    numNested := 0
+    isRec := false
+    isUnsafe := false
+    isReflexive := false
+  }
+  let propUnit := `PropUnit
+  let propUnitMk := `PropUnit.mk
+  let propInd : ConstantInfo := .inductInfo {
+    name := propUnit
+    levelParams := []
+    type := .sort .zero
+    numParams := 0
+    numIndices := 0
+    all := [propUnit]
+    ctors := [propUnitMk]
+    numNested := 0
+    isRec := false
+    isUnsafe := false
+    isReflexive := false
+  }
+  let propCtor : ConstantInfo := .ctorInfo {
+    name := propUnitMk
+    levelParams := []
+    type := .const propUnit []
+    induct := propUnit
+    cidx := 0
+    numParams := 0
+    numFields := 0
+    isUnsafe := false
+  }
+  let boxCtor : ConstantInfo := .ctorInfo {
+    name := boxMk
+    levelParams := []
+    type := .forallE `x (.const propUnit []) (.const boxName []) .default
+    induct := boxName
+    cidx := 0
+    numParams := 0
+    numFields := 1
+    isUnsafe := false
+  }
+  let boxVal : ConstantInfo := .defnInfo {
+    name := `boxVal
+    levelParams := []
+    type := .const boxName []
+    value := .app (.const boxMk []) (.const propUnitMk [])
+    hints := .abbrev
+    safety := .safe
+    all := [`boxVal]
+  }
+  -- Theorem whose type mentions only PropUnit and whose value mentions only `boxVal` + `.proj ProjBox 0 ...`
+  let projThm : ConstantInfo := .thmInfo {
+    name := `projUser
+    levelParams := []
+    type := .const propUnit []
+    value := .proj boxName 0 (.const `boxVal [])
+    all := [`projUser]
+  }
+  for threads in [1, 4] do
+    expectAccept s!"proj_dependency_threads_{threads}" do
+      Comparator.ParallelReplay.checkParallel threads
+        (mkMap [(`projUser, projThm), (`boxVal, boxVal), (boxName, boxInd), (boxMk, boxCtor),
+                (propUnit, propInd), (propUnitMk, propCtor)]) emptyEnv
+
+  -- 9.Forged theorem body rejected identically across N=1 and N=4
+  let badPropThm : ConstantInfo := .thmInfo {
+    name := `badPropThm
+    levelParams := []
+    type := .const propUnit []
+    value := .sort .zero -- ill-typed proof term
+    all := [`badPropThm]
+  }
+  for threads in [1, 4] do
+    expectReject s!"forged_thm_threads_{threads}" "while replaying declaration 'badPropThm'" do
+      Comparator.ParallelReplay.checkParallel threads
+        (mkMap [(propUnit, propInd), (propUnitMk, propCtor), (`badPropThm, badPropThm)]) emptyEnv
+
+  -- 10. Unsafe and partial ConstantInfo rejected directly by checkParallel
+  let unsafeDef : ConstantInfo := .defnInfo {
+    name := `badUnsafe
+    levelParams := []
+    type := .const propUnit []
+    value := .const `badUnsafe []
+    hints := .opaque
+    safety := .unsafe
+    all := [`badUnsafe]
+  }
+  expectReject "unsafe_constant_info" "unsafe or partial declaration" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(propUnit, propInd), (propUnitMk, propCtor), (`badUnsafe, unsafeDef)]) emptyEnv
+
+  let partialDef : ConstantInfo := .defnInfo {
+    name := `badPartialDirect
+    levelParams := []
+    type := .const propUnit []
+    value := .const propUnitMk []
+    hints := .opaque
+    safety := .partial
+    all := [`badPartialDirect]
+  }
+  expectReject "partial_constant_info" "unsafe or partial declaration" do
+    Comparator.ParallelReplay.checkParallel 2 (mkMap [(propUnit, propInd), (propUnitMk, propCtor), (`badPartialDirect, partialDef)]) emptyEnv
+
+  -- 11. Invalid numThreads = 0 rejected
+  expectReject "zero_threads" "numThreads >= 1" do
+    Comparator.ParallelReplay.checkParallel 0 {} emptyEnv
+
+  -- 12. Duplicate theorem subsumption parity with Lean.Environment.replay:
+  --     when an identical theorem (name, type, levelParams, all) already exists in base `env`,
+  --     replay skips it without failing with `already_declared`; if type/levelParams/all differ,
+  --     kernel replay rejects with already-declared error.
+  let baseWithThm ← do
+    let validThmDecl : Declaration := .thmDecl {
+      name := `dupSubsumedThm
+      levelParams := []
+      type := .forallE `p (.sort .zero) (.forallE `h (.bvar 0) (.bvar 1) .default) .default
+      value := .lam `p (.sort .zero) (.lam `h (.bvar 0) (.bvar 0) .default) .default
+      all := [`dupSubsumedThm]
+    }
+    match emptyEnv.addDeclCore 0 0 validThmDecl none with
+    | .ok env' => pure env'
+    | .error _ => throw <| IO.userError "failed to construct baseWithThm"
+  let dupMatchingThm : ConstantInfo := .thmInfo {
+    name := `dupSubsumedThm
+    levelParams := []
+    type := .forallE `p (.sort .zero) (.forallE `h (.bvar 0) (.bvar 1) .default) .default
+    value := .sort .zero -- not re-checked when already proven in base env, matching Replay.lean:90-96
+    all := [`dupSubsumedThm]
+  }
+  for threads in [1, 4] do
+    expectAccept s!"subsumed_thm_threads_{threads}" do
+      Comparator.ParallelReplay.checkParallel threads (mkMap [(`dupSubsumedThm, dupMatchingThm)]) baseWithThm
+
+  let dupMismatchedTypeThm : ConstantInfo := .thmInfo {
+    name := `dupSubsumedThm
+    levelParams := []
+    type := .forallE `p (.sort .zero) (.bvar 0) .default -- mismatched statement!
+    value := .sort .zero
+    all := [`dupSubsumedThm]
+  }
+  for threads in [1, 4] do
+    expectReject s!"mismatched_dup_thm_threads_{threads}" "while replaying declaration 'dupSubsumedThm'" do
+      Comparator.ParallelReplay.checkParallel threads (mkMap [(`dupSubsumedThm, dupMismatchedTypeThm)]) baseWithThm
+
+  -- 13. String literal implicit kernel dependencies (`String.ofList`, `Char.ofNat`)
+  --     when the user theorem's `Name.hash` sorts before `String.ofList` and `Char.ofNat` in `NameSet`.
+  let fullInitEnv ← importModules #[{ module := `Init }] {}
+  let strLitThmName := `t_0
+  let mut closure : Std.HashMap Name ConstantInfo := {}
+  let mut work : Array Name := #[``String.ofList, ``Char.ofNat, ``List, ``ByteArray.mk, ``Array.mk, ``Eq, ``Eq.refl]
+  while h : work.size > 0 do
+    let n := work.back
+    work := work.pop
+    if !closure.contains n then
+      if let some ci := fullInitEnv.find? n then
+        closure := closure.insert n ci
+        for dep in ci.getUsedConstantsAsSet do
+          work := work.push dep
+        match ci with
+        | .inductInfo iv =>
+          for c in iv.ctors do work := work.push c
+        | .ctorInfo cv =>
+          work := work.push cv.induct
+        | .recInfo rv =>
+          for ind in rv.all do work := work.push ind
+          for rule in rv.rules do work := work.push rule.ctor
+        | _ => pure ()
+  let strLitExpr := Expr.lit (.strVal "a")
+  let strToByteArr := Expr.proj ``String 0 strLitExpr
+  let strLitThm : ConstantInfo := .thmInfo {
+    name := strLitThmName
+    levelParams := []
+    type := mkApp3 (.const ``Eq [.succ .zero]) (.const ``ByteArray []) strToByteArr strToByteArr
+    value := mkApp2 (.const ``Eq.refl [.succ .zero]) (.const ``ByteArray []) strToByteArr
+    all := [strLitThmName]
+  }
+  -- Also test kernel reduction of `.proj String 0 (.lit (.strVal "a"))` against concrete `[97]` ByteArray
+  let u8List := mkApp3 (.const ``List.cons [.zero]) (.const ``UInt8 [])
