+partial def copy64 (src dst : IO.FS.Handle) : IO Unit := do
+  let chunk ← src.read 65536
+  unless chunk.isEmpty do
+    dst.write chunk
+    copy64 src dst
+
+def spoolProcess (args : IO.Process.SpawnArgs) (dst : IO.FS.Handle) : IO Unit := do
+  let proc ← IO.Process.spawn { args with stdout := .piped, stderr := .inherit, stdin := .null }
+  copy64 proc.stdout dst
+  let status ← proc.wait
+  if status != 0 then throw <| IO.userError s!"Child exited with {status}"
+  dst.flush
+  dst.rewind
+
+def runSandBoxedToFile (spawnArgs : LandrunArgs) (dst : IO.FS.Handle) : M Unit := do
+  spoolProcess {
+    cmd := (← read).whichLandrun
+    args := buildLandrunArgs spawnArgs
+    env := spawnArgs.envOverride
+    cwd := (← getProjectDir)
+  } dst
+
