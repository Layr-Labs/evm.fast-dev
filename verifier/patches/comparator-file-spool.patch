+open Lean
+
+structure Hooks where
+  onConfigure : BaseIO Unit := pure ()
+  onCollect : BaseIO Unit := pure ()
+
+private def mixHash64 (h : UInt64) : UInt64 :=
+  let h := (h ^^^ (h >>> 30)) * 0xbf58476d1ce4e5b9
+  let h := (h ^^^ (h >>> 27)) * 0x94d049bb133111eb
+  h ^^^ (h >>> 31)
+
+private def disperseNames (names : Array Name) : Array Name :=
+  if names.size ≤ 1 then
+    names
+  else
+    names.qsort fun a b =>
+      let ha := mixHash64 a.hash
+      let hb := mixHash64 b.hash
+      if ha != hb then ha < hb else Name.quickLt a b
+
+private def nameSetToDispersedArray (ns : NameSet) : Array Name :=
+  disperseNames ns.toArray
+
+private unsafe def collectExprRefsUnsafe (e : Expr) : NameSet :=
+  let rec visit (e : Expr) : StateM (PtrSet Expr × NameSet) Unit := do
+    if (← get).1.contains e then
+      return ()
+    modify fun (v, cs) => (v.insert e, cs)
+    match e with
+    | .forallE _ d b _ => visit d; visit b
+    | .lam _ d b _ => visit d; visit b
+    | .mdata _ b => visit b
+    | .letE _ t v b _ => visit t; visit v; visit b
+    | .app f a => visit f; visit a
+    | .proj typeName _ b =>
+      modify fun (v, cs) => (v, cs.insert typeName)
+      visit b
+    | .const c _ =>
+      modify fun (v, cs) => (v, cs.insert c)
+    | .lit (.natVal _) =>
+      modify fun (v, cs) =>
+        (v, ((cs.insert ``Nat).insert ``Nat.zero).insert ``Nat.succ)
+    | .lit (.strVal _) =>
+      modify fun (v, cs) =>
+        let cs := (((cs.insert ``String).insert ``Char).insert ``String.ofList).insert ``Char.ofNat
+        let cs := (((cs.insert ``List).insert ``List.nil).insert ``List.cons).insert ``Nat
+        (v, (cs.insert ``Nat.zero).insert ``Nat.succ)
+    | _ => return ()
+  (visit e |>.run (mkPtrSet, {})).2.2
+
+@[implemented_by collectExprRefsUnsafe]
+private opaque collectExprRefs (e : Expr) : NameSet := {}
+
+private unsafe def hasNonTrivialReflOrEagerUnsafe (e : Expr) : Bool :=
+  let rec visit (e : Expr) : StateM (PtrSet Expr) Bool := do
+    if (← get).contains e then
+      return false
+    modify fun v => v.insert e
+    match e with
+    | .const c _ =>
+      return c == ``eagerReduce
+    | .app (.app (.app (.app (.const ``Eq.mpr _) _) _) hEq) hBody =>
+      if ← visit hEq then return true
+      visit hBody
+    | .app (.app (.app (.app (.const ``Eq.mp _) _) _) hEq) hBody =>
+      if ← visit hEq then return true
+      visit hBody
+    | .app (.app (.app (.app (.app (.app (.const ``Eq.ndrec _) _) x) _) hBody) y) hEq =>
+      if x == y then
+        visit hBody
+      else
+        if ← visit hEq then return true
+        visit hBody
+    | .app (.app (.app (.app (.app (.app (.const ``Eq.rec _) _) x) _) hBody) y) hEq =>
+      if x == y then
+        visit hBody
+      else
+        if ← visit hEq then return true
+        visit hBody
+    | .app (.app (.app (.app (.app (.app (.const ``Eq.trans _) _) x) y) z) h1) h2 =>
+      let c1 ← if x == y then pure false else visit h1
+      if c1 then return true
+      if y == z then return false else visit h2
+    | .app (.app (.const ``Eq.refl _) _) _ =>
+      return true
+    | .forallE _ d b _ =>
+      if ← visit d then return true
+      visit b
+    | .lam _ d b _ =>
+      if ← visit d then return true
+      visit b
+    | .mdata _ b =>
+      visit b
+    | .letE _ t v b _ =>
+      if ← visit t then return true
+      if ← visit v then return true
+      visit b
+    | .app f a =>
+      if ← visit f then return true
+      visit a
+    | .proj _ _ b =>
+      visit b
+    | _ =>
+      return false
+  (visit e |>.run mkPtrSet).1
+
+@[implemented_by hasNonTrivialReflOrEagerUnsafe]
+private opaque hasNonTrivialReflOrEager (e : Expr) : Bool := false
+
+private def isRootTrivialSyntacticRefl (ty val : Expr) : Bool :=
+  match val with
+  | .app (.app (.const ``Eq.refl _) _) x =>
+    match ty with
+    | .app (.app (.app (.const ``Eq _) _) lhs) rhs =>
+      lhs == rhs && lhs == x
+    | _ => false
+  | _ => false
+
+private def classifyHeavyReduction (c : ConstantInfo) : Bool :=
+  match c with
+  | .thmInfo info =>
+    if isRootTrivialSyntacticRefl info.type info.value then
+      false
+    else
+      hasNonTrivialReflOrEager info.value || hasNonTrivialReflOrEager info.type
+  | .defnInfo info =>
+    hasNonTrivialReflOrEager info.value || hasNonTrivialReflOrEager info.type
+  | .opaqueInfo info =>
+    hasNonTrivialReflOrEager info.value || hasNonTrivialReflOrEager info.type
+  | _ => false
+
+private def getUsedRefs (c : ConstantInfo) : NameSet :=
+  let acc := collectExprRefs c.type
+  match c.value? (allowOpaque := true) with
+  | some v => acc.union (collectExprRefs v)
+  | none =>
+    match c with
+    | .inductInfo val => acc.union (NameSet.ofList val.ctors)
+    | .ctorInfo val => acc.insert val.name
+    | .recInfo val => acc.union (NameSet.ofList val.all)
+    | _ => acc
+
+private def readProcessAnonRssGiB : BaseIO Nat := do
+  let act : IO Nat := do
+    let text ← IO.FS.readFile "/proc/self/statm"
+    let parts := text.trimAscii.toString.splitOn " "
+    match parts with
+    | _ :: residentStr :: sharedStr :: _ =>
+      let resident := residentStr.toNat?.getD 0
+      let shared := sharedStr.toNat?.getD 0
+      let anonPages := resident - shared
+      return (anonPages * 4096) / (1024 * 1024 * 1024)
+    | _ :: residentStr :: _ =>
+      let resident := residentStr.toNat?.getD 0
+      return (resident * 4096) / (1024 * 1024 * 1024)
+    | _ =>
+      return 0
+  EIO.catchExceptions act (fun _ => pure 0)
+
+private def allowedWorkersForRssGiB (numWorkers rssGiB : Nat) : Nat :=
+  let cap :=
+    if rssGiB < 34 then numWorkers
+    else if rssGiB < 44 then 3
+    else if rssGiB < 52 then 2
+    else 1
+  Nat.max 1 (Nat.min numWorkers cap)
+
+private def maxHeavyWorkersForRssGiB (numWorkers rssGiB : Nat) : Nat :=
+  if numWorkers ≤ 1 then
+    1
+  else if rssGiB < 36 then
+    Nat.min 2 numWorkers
+  else
+    1
+
+private structure DeferredDecl where
+  name : Name
+  envBefore : Kernel.Environment
+  expected : ConstantInfo
+  decl : Declaration
+  isHeavy : Bool
+
+private structure WorkQueueState where
+  ring : Array (Option DeferredDecl)
+  head : Nat := 0
+  tail : Nat := 0
+  count : Nat := 0
+  closed : Bool := false
+  activeWorkers : Nat := 0
+  activeHeavy : Nat := 0
+  checkedCount : Nat := 0
+  firstError : Option String := none
+
+private structure WorkQueue where
+  capacity : Nat
+  numWorkers : Nat
+  hooks : Hooks
+  mutex : Std.Mutex WorkQueueState
+  notEmpty : Std.Condvar
+  notFull : Std.Condvar
+  cancelTk : IO.CancelToken
+
+private def WorkQueue.new (capacity numWorkers : Nat) (hooks : Hooks) : BaseIO WorkQueue := do
+  let cap := Nat.max 1 capacity
+  let nw := Nat.max 1 numWorkers
+  let mutex ← Std.Mutex.new { ring := Array.replicate cap none }
+  let notEmpty ← Std.Condvar.new
+  let notFull ← Std.Condvar.new
+  let cancelTk ← IO.CancelToken.new
+  return { capacity := cap, numWorkers := nw, hooks, mutex, notEmpty, notFull, cancelTk }
+
+private def WorkQueue.recordError (q : WorkQueue) (msg : String) : BaseIO Unit := do
+  q.cancelTk.set
+  q.mutex.atomically do
+    modify fun s => {
+      s with
+      closed := true
+      firstError := match s.firstError with
+        | some prev => some prev
+        | none => some msg
+    }
+  q.notEmpty.notifyAll
+  q.notFull.notifyAll
+
+private def WorkQueue.close (q : WorkQueue) : BaseIO Unit := do
+  q.mutex.atomically do
+    modify fun s => { s with closed := true }
+  q.notEmpty.notifyAll
+  q.notFull.notifyAll
+
+private def WorkQueue.push (q : WorkQueue) (item : DeferredDecl) : BaseIO Bool := do
+  let pushed ← q.mutex.atomicallyOnce q.notFull
+    (do
+      let s ← get
+      return s.closed || s.count < q.capacity)
+    (do
+      let s ← get
+      if s.closed then
+        return false
+      let ring := s.ring.set! s.tail (some item)
+      let tail := if s.tail + 1 == q.capacity then 0 else s.tail + 1
+      set { s with ring, tail, count := s.count + 1 }
+      return true)
+  if pushed then
+    q.notEmpty.notifyAll
+  return pushed
+
+private def findAdmissibleOffset? (s : WorkQueueState) (cap maxHeavy : Nat) : Option Nat := Id.run do
+  for off in [0:s.count] do
+    let idx := (s.head + off) % cap
+    if let some cand := s.ring[idx]! then
+      if !cand.isHeavy || s.activeHeavy < maxHeavy || s.activeWorkers == 0 then
+        return some off
+  return none
+
+private inductive PopOutcome where
+  | done
+  | waitEmpty
+  | waitAdmit
+  | popped (item : DeferredDecl)
+
+private def removeRingAtOffset (s : WorkQueueState) (cap off : Nat) : Option DeferredDecl × WorkQueueState := Id.run do
+  let targetIdx := (s.head + off) % cap
+  let item? := s.ring[targetIdx]!
+  let mut ring := s.ring
+  let mut cur := off
+  while cur > 0 do
+    let dst := (s.head + cur) % cap
+    let src := (s.head + cur - 1) % cap
+    ring := ring.set! dst ring[src]!
+    cur := cur - 1
+  ring := ring.set! s.head none
+  let head := if s.head + 1 == cap then 0 else s.head + 1
+  return (item?, { s with ring, head, count := s.count - 1 })
+
+private partial def WorkQueue.pop (q : WorkQueue) : BaseIO (Option DeferredDecl) := do
+  let rssGiB ← readProcessAnonRssGiB
+  let allowedWorkers := allowedWorkersForRssGiB q.numWorkers rssGiB
+  let maxHeavy := maxHeavyWorkersForRssGiB q.numWorkers rssGiB
+  let outcome : PopOutcome ← q.mutex.atomically do
+    let s ← get
+    if s.firstError.isSome then
+      return .done
+    if s.count == 0 then
+      if s.closed then
+        return .done
+      else
+        return .waitEmpty
+    if s.activeWorkers == 0 || s.activeWorkers < allowedWorkers then
+      if let some off := findAdmissibleOffset? s q.capacity maxHeavy then
+        let (item?, s') := removeRingAtOffset s q.capacity off
+        if let some item := item? then
+          let activeHeavy := if item.isHeavy then s'.activeHeavy + 1 else s'.activeHeavy
+          set { s' with activeWorkers := s'.activeWorkers + 1, activeHeavy }
+          return .popped item
+    if s.activeWorkers == 0 then
+      let (item?, s') := removeRingAtOffset s q.capacity 0
+      if let some item := item? then
+        let activeHeavy := if item.isHeavy then s'.activeHeavy + 1 else s'.activeHeavy
+        set { s' with activeWorkers := 1, activeHeavy }
+        return .popped item
+    return .waitAdmit
+  match outcome with
+  | .done =>
+    return none
+  | .popped item =>
+    q.notFull.notifyOne
+    return some item
+  | .waitEmpty =>
+    q.mutex.atomically do
+      let s ← get
+      if s.firstError.isNone && s.count == 0 && !s.closed then
+        q.notEmpty.wait q.mutex
+    WorkQueue.pop q
+  | .waitAdmit =>
+    if rssGiB ≥ 36 then
+      q.hooks.onCollect
+    IO.sleep 25
+    WorkQueue.pop q
+
+private def WorkQueue.finishItem (q : WorkQueue) (isHeavy ok : Bool) : BaseIO Unit := do
+  q.mutex.atomically do
+    modify fun s => {
+      s with
+      activeWorkers := s.activeWorkers - 1
+      activeHeavy := if isHeavy then s.activeHeavy - 1 else s.activeHeavy
+      checkedCount := if ok then s.checkedCount + 1 else s.checkedCount
+    }
+  q.notEmpty.notifyAll
+
+private partial def workerLoop (q : WorkQueue) (localDone : Nat := 0) : BaseIO Unit := do
+  if ← q.cancelTk.isSet then
+    q.hooks.onCollect
+    return ()
+  match ← q.pop with
+  | none =>
+    q.hooks.onCollect
+    return ()
+  | some item =>
+    let isHeavy := item.isHeavy
+    match item.envBefore.addDeclCore 0 0 item.decl (cancelTk? := some q.cancelTk) with
+    | .ok envChecked =>
+      match envChecked.find? item.name with
+      | some actual =>
+        if actual == item.expected then
+          q.finishItem isHeavy true
+          let nextDone := localDone + 1
+          if isHeavy || nextDone % 256 == 0 then
+            q.hooks.onCollect
+          else if nextDone % 64 == 0 then
+            let rssGiB ← readProcessAnonRssGiB
+            if rssGiB ≥ 32 then
+              q.hooks.onCollect
+          workerLoop q nextDone
+        else
+          q.finishItem isHeavy false
+          q.recordError s!"while replaying declaration '{item.name}':\nkernel constant mismatch"
+      | none =>
+        q.finishItem isHeavy false
+        q.recordError s!"while replaying declaration '{item.name}':\nmissing constant after kernel check"
+    | .error ex =>
+      q.finishItem isHeavy false
+      if ex matches .interrupted then
+        if ← q.cancelTk.isSet then
+          q.hooks.onCollect
+          return ()
+      let msg ← ex.toMessageData {} |>.toString
+      q.recordError s!"while replaying declaration '{item.name}':\n{msg}"
+
+private structure Context where
+  queue : WorkQueue
+
+private structure State where
+  env : Kernel.Environment
+  unclaimed : Std.HashMap Name ConstantInfo
+  inProgress : NameSet := {}
+  pending : NameSet := {}
+  postponedInductives : NameMap ConstantInfo := {}
+  postponedConstructors : NameMap ConstantInfo := {}
+  postponedRecursors : NameMap ConstantInfo := {}
+  postponedQuotients : NameMap ConstantInfo := {}
+  enqueued : Nat := 0
+
+private abbrev M := ReaderT Context <| StateRefT State IO
+
+private def throwWorkerErrorOrStopped : M α := do
+  let err? ← (← read).queue.mutex.atomically do
+    return (← get).firstError
+  match err? with
+  | some err => throw <| .userError err
+  | none => throw <| .userError "parallel kernel replay stopped unexpectedly"
+
+private def throwKernelException (ex : Kernel.Exception) : IO α := do
+  throw <| .userError <| (← ex.toMessageData {} |>.toString)
+
+private def claimConstant? (name : Name) : M (Option ConstantInfo) := do
+  modifyGet fun s =>
+    match s.unclaimed[name]? with
+    | none => (none, s)
+    | some ci => (some ci, { s with unclaimed := s.unclaimed.erase name })
+
+private def addDeclChecked (name : Name) (expected : ConstantInfo) (d : Declaration) : M Unit := do
+  match (← get).env.addDeclCore 0 0 d (cancelTk? := some (← read).queue.cancelTk) with
+  | .ok env =>
+    match env.find? name with
+    | some actual =>
+      if !(actual == expected) then
+        throw <| .userError s!"kernel constant mismatch after checking '{name}'"
+      modify fun s => { s with env := env }
+    | none =>
+      throw <| .userError s!"missing constant '{name}' after kernel check"
+  | .error ex =>
+    if ex matches .interrupted then
+      if ← (← read).queue.cancelTk.isSet then
+        throwWorkerErrorOrStopped
+    throwKernelException ex
+
+private def addInductChecked (d : Declaration) : M Unit := do
+  match (← get).env.addDeclCore 0 0 d (cancelTk? := some (← read).queue.cancelTk) with
+  | .ok env => modify fun s => { s with env := env }
+  | .error ex =>
+    if ex matches .interrupted then
+      if ← (← read).queue.cancelTk.isSet then
+        throwWorkerErrorOrStopped
+    throwKernelException ex
+
+private def deferDecl (name : Name) (expected : ConstantInfo) (d : Declaration) : M Unit := do
+  if ← (← read).queue.cancelTk.isSet then
+    throwWorkerErrorOrStopped
+  let envBefore := (← get).env
+  match envBefore.addDeclWithoutChecking d with
+  | .ok envAfter =>
+    match envAfter.find? name with
+    | some inserted =>
+      if !(inserted == expected) then
+        throw <| .userError s!"unchecked constant mismatch for '{name}'"
+      let isHeavy := classifyHeavyReduction expected
+      modify fun s => { s with env := envAfter, enqueued := s.enqueued + 1 }
+      let ok ← (← read).queue.push { name, envBefore, expected, decl := d, isHeavy }
+      if !ok then
+        throwWorkerErrorOrStopped
+    | none =>
+      throw <| .userError s!"missing constant '{name}' after unchecked insert"
+  | .error ex => throwKernelException ex
+
+mutual
+
+private partial def prepareConstant (name : Name) : M Unit := do
+  if ← (← read).queue.cancelTk.isSet then
+    throwWorkerErrorOrStopped
+  if (← get).inProgress.contains name then
+    throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+  if let some ci ← claimConstant? name then
+    modify fun s => {
+      s with
+      inProgress := s.inProgress.insert name
+      pending := s.pending.insert name
+    }
+    try
+      if ci.name != name then
+        throw <| .userError s!"mismatched constant name '{ci.name}' at key '{name}'"
+      match ci with
+      | .defnInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          deferDecl name ci (.defnDecl info)
+      | .thmInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          let alreadySubsumed ← do
+            if let some (.thmInfo info') := (← get).env.find? ci.name then
+              pure (info.name == info'.name &&
+                    info.type == info'.type &&
+                    info.levelParams == info'.levelParams &&
+                    info.all == info'.all)
+            else
+              pure false
+          if !alreadySubsumed then
+            deferDecl name ci (.thmDecl info)
+      | .opaqueInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          deferDecl name ci (.opaqueDecl info)
+      | .axiomInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          addDeclChecked name ci (.axiomDecl info)
+      | .inductInfo info =>
+        let lparams := info.levelParams
+        let nparams := info.numParams
+        if !info.all.contains name then
+          throw <| .userError s!"malformed inductive '{name}': missing from `all`"
+        let mut seenAll : NameSet := {}
+        for n in info.all do
+          if seenAll.contains n then
+            throw <| .userError s!"malformed inductive '{name}': duplicate entries in `all`"
+          seenAll := seenAll.insert n
+        let all ← info.all.mapM fun n => do
+          let ci ←
+            if n == name then
+              pure ci
+            else do
+              if (← get).inProgress.contains n then
+                throw <| .userError s!"cyclic dependency through mutual inductive '{n}'"
+              match ← claimConstant? n with
+              | some other => pure other
+              | none =>
+                match (← get).postponedInductives.find? n with
+                | some prev => pure prev
+                | none => throw <| .userError s!"missing mutual inductive '{n}'"
+          let .inductInfo _ := ci
+            | throw <| .userError s!"mutual inductive entry '{n}' is not an inductive"
+          if ci.name != n then
+            throw <| .userError s!"mismatched inductive name '{ci.name}' at key '{n}'"
+          pure ci
+        let blockNames := seenAll
+        let mut blockCtors : NameSet := {}
+        let mut ctorInfo : List (ConstantInfo × List ConstantInfo) := []
+        for indCi in all do
+          let mut ctors : List ConstantInfo := []
+          for n in indCi.inductiveVal!.ctors do
+            if blockCtors.contains n then
+              throw <| .userError s!"malformed inductive '{name}': duplicate constructor '{n}'"
+            if blockNames.contains n then
+              throw <| .userError s!"malformed inductive '{name}': constructor '{n}' collides with inductive name"
+            blockCtors := blockCtors.insert n
+            if (← get).inProgress.contains n then
+              throw <| .userError s!"cyclic dependency through constructor '{n}'"
+            let c ← match ← claimConstant? n with
+              | some claimed => pure claimed
+              | none =>
+                match (← get).postponedConstructors.find? n with
+                | some prev => pure prev
+                | none => throw <| .userError s!"missing constructor '{n}' for '{indCi.name}'"
+            let .ctorInfo cval := c
+              | throw <| .userError s!"constant '{n}' for inductive '{indCi.name}' is not a constructor"
+            if c.name != n then
+              throw <| .userError s!"mismatched constructor name '{c.name}' at key '{n}'"
+            if cval.induct != indCi.name then
+              throw <| .userError s!"constructor '{n}' claims inductive '{cval.induct}', expected '{indCi.name}'"
+            ctors := ctors ++ [c]
+          ctorInfo := ctorInfo ++ [(indCi, ctors)]
+        for o in all do
+          modify fun s => {
+            s with
+            pending := s.pending.erase o.name
+            inProgress := s.inProgress.insert o.name
+            postponedInductives := s.postponedInductives.insert o.name o
+          }
+        for (_, ctors) in ctorInfo do
+          for c in ctors do
+            modify fun s => {
+              s with
+              pending := s.pending.erase c.name
+              inProgress := s.inProgress.insert c.name
+              postponedConstructors := s.postponedConstructors.insert c.name c
+            }
+        try
+          for o in all do
+            let deps := ((collectExprRefs o.type).diff blockNames).diff blockCtors
+            prepareConstants deps
+          for (_, ctors) in ctorInfo do
+            for ctor in ctors do
+              let deps := ((collectExprRefs ctor.type).diff blockNames).diff blockCtors
+              prepareConstants deps
+          let types : List InductiveType := ctorInfo.map fun (indCi, ctors) =>
+            { name := indCi.name
+              type := indCi.type
+              ctors := ctors.map fun c => { name := c.name, type := c.type } }
+          addInductChecked (.inductDecl lparams nparams types false)
+        finally
+          for o in all do
+            if o.name != name then
+              modify fun s => { s with inProgress := s.inProgress.erase o.name }
+          for c in blockCtors do
+            modify fun s => { s with inProgress := s.inProgress.erase c }
+      | .ctorInfo info =>
+        let deps := ((collectExprRefs info.type).erase name).erase info.induct
+        modify fun s => {
+          s with
+          postponedConstructors := s.postponedConstructors.insert info.name ci
+          pending := s.pending.erase name
+          inProgress := s.inProgress.erase name
+        }
+        prepareConstant info.induct
+        prepareConstants deps
+      | .recInfo info =>
+        let deps := info.rules.foldl (init := collectExprRefs info.type) fun acc rule =>
+          (acc.insert rule.ctor).union (collectExprRefs rule.rhs)
+        let deps := (deps.erase name).diff (NameSet.ofList info.all)
+        modify fun s => {
+          s with
+          postponedRecursors := s.postponedRecursors.insert info.name ci
+          pending := s.pending.erase name
+          inProgress := s.inProgress.erase name
+        }
+        for indName in info.all do
+          prepareConstant indName
+        prepareConstants deps
+      | .quotInfo _ =>
+        let quotNames : List Name := [``Quot, ``Quot.mk, ``Quot.lift, ``Quot.ind]
+        if !quotNames.contains name then
+          throw <| .userError s!"unexpected quotient declaration '{name}'"
+        let blockQuot := NameSet.ofList quotNames
+        for q in quotNames do
+          if q != name && (← get).inProgress.contains q then
+            throw <| .userError s!"cyclic dependency through quotient '{q}'"
+        let mut deps : NameSet := {}
+        for q in quotNames do
+          let qci? ←
+            if q == name then
+              pure (some ci)
+            else do
+              match ← claimConstant? q with
+              | some claimed => pure (some claimed)
+              | none => pure ((← get).postponedQuotients.find? q)
+          if let some qci := qci? then
+            let .quotInfo _ := qci
+              | throw <| .userError s!"constant '{q}' must be a quotient declaration"
+            if qci.name != q then
+              throw <| .userError s!"mismatched quotient name '{qci.name}' at key '{q}'"
+            deps := deps.union ((getUsedRefs qci).diff blockQuot)
+            modify fun s => {
+              s with
+              pending := s.pending.erase q
+              inProgress := s.inProgress.insert q
+              postponedQuotients := s.postponedQuotients.insert q qci
+            }
+          else
+            modify fun s => { s with inProgress := s.inProgress.insert q }
+        try
+          prepareConstants deps
+          prepareConstant ``Eq
+          if ((← get).env.find? ``Quot).isNone then
+            addInductChecked .quotDecl
+        finally
+          for q in quotNames do
+            if q != name then
+              modify fun s => { s with inProgress := s.inProgress.erase q }
+      modify fun s => { s with pending := s.pending.erase name, inProgress := s.inProgress.erase name }
+    catch ex =>
+      modify fun s => { s with inProgress := s.inProgress.erase name }
+      if ← (← read).queue.cancelTk.isSet then
+        throw ex
+      throw <| .userError s!"while replaying declaration '{name}':\n{ex}"
+
+private partial def prepareConstants (names : NameSet) : M Unit := do
+  for n in nameSetToDispersedArray names do
+    prepareConstant n
+
+end
+
+private def checkPostponedInductives : M Unit := do
+  for (ind, expected) in (← get).postponedInductives do
+    match (← get).env.find? ind, expected with
+    | some (.inductInfo info), .inductInfo info' =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid inductive {ind}"
+    | _, _ =>
+      throw <| IO.userError s!"No such inductive {ind}"
+  modify fun s => { s with postponedInductives := {} }
+
+private def checkPostponedConstructors : M Unit := do
+  for (ctor, expected) in (← get).postponedConstructors do
+    match (← get).env.find? ctor, expected with
+    | some (.ctorInfo info), .ctorInfo info' =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid constructor {ctor}"
+    | _, _ =>
+      throw <| IO.userError s!"No such constructor {ctor}"
+  modify fun s => { s with postponedConstructors := {} }
+
+private def checkPostponedRecursors : M Unit := do
+  for (recName, expected) in (← get).postponedRecursors do
+    match (← get).env.find? recName, expected with
+    | some (.recInfo info), .recInfo info' =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid recursor {recName}"
+    | _, _ =>
+      throw <| IO.userError s!"No such recursor {recName}"
+  modify fun s => { s with postponedRecursors := {} }
+
+private def checkPostponedQuotients : M Unit := do
+  for (qName, expected) in (← get).postponedQuotients do
+    match (← get).env.find? qName, expected with
+    | some (.quotInfo info), .quotInfo info' =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid quotient {qName}"
+    | _, _ =>
+      throw <| IO.userError s!"No such quotient {qName}"
+  modify fun s => { s with postponedQuotients := {} }
+
+private def defaultQueueCapacity (numThreads : Nat) : Nat :=
+  Nat.max 32 (numThreads * 8)
+
+def checkParallel (numThreads : Nat) (newConstants : Std.HashMap Name ConstantInfo)
+    (env : Environment) (hooks : Hooks := {}) : IO Unit := do
+  if numThreads == 0 then
+    throw <| IO.userError "checkParallel requires numThreads >= 1"
+  hooks.onConfigure
+  let mut roots : Array Name := Array.mkEmpty newConstants.size
+  for (n, ci) in newConstants do
+    if !ci.isUnsafe && !ci.isPartial then
+      roots := roots.push n
+    else
+      throw <| IO.userError s!"unsafe or partial declaration '{n}' is not permitted in kernel replay"
+  let rootList := disperseNames roots
+  roots := #[]
+  if rootList.isEmpty then
+    return ()
+  let workers := Nat.min numThreads rootList.size
+  let queue ← WorkQueue.new (defaultQueueCapacity workers) workers hooks
+  let mut tasks : Array (Task Unit) := Array.mkEmpty workers
+  for _ in [0:workers] do
+    let task ← BaseIO.asTask (prio := .dedicated) (workerLoop queue)
+    tasks := tasks.push task
+  let mut prepError : Option IO.Error := none
+  let mut totalEnqueued : Nat := 0
+  try
+    let (_, s) ← StateRefT'.run (s := { env := env.toKernelEnv, unclaimed := newConstants }) do
+      ReaderT.run (r := { queue }) do
+        for n in rootList do
+          prepareConstant n
+        checkPostponedInductives
+        checkPostponedConstructors
+        checkPostponedRecursors
+        checkPostponedQuotients
+    totalEnqueued := s.enqueued
+    queue.close
+  catch ex =>
+    prepError := some ex
+    queue.recordError ex.toString
+  for task in tasks do
+    let () ← IO.wait task
+  hooks.onCollect
+  let finalState ← queue.mutex.atomically get
+  if let some err := prepError then
+    if let some workerErr := finalState.firstError then
+      if workerErr != err.toString then
+        throw <| IO.userError workerErr
+    throw err
+  if let some err := finalState.firstError then
+    throw <| IO.userError err
+  if finalState.checkedCount != totalEnqueued then
+    throw <| IO.userError
+      s!"internal error: kernel checked {finalState.checkedCount} of {totalEnqueued} deferred declarations"
+
+end Comparator.ParallelReplay
