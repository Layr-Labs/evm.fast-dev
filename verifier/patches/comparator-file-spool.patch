+import Comparator.Compare
+import Lean.Replay
+import Lean.Util.PtrSet
+
+namespace Comparator.ParallelReplay
+
+open Lean
+
+private unsafe def collectExprRefsUnsafe (e : Expr) : NameSet :=
+  let rec visit (e : Expr) : StateM (PtrSet Expr × NameSet) Unit := do
+    if (← get).1.contains e then
+      return ()
+    modify fun (v, cs) => (v.insert e, cs)
+    match e with
+    | .forallE _ d b _ => visit d; visit b
+    | .lam _ d b _ => visit d; visit b
+    | .mdata _ b => visit b
+    | .letE _ t v b _ => visit t; visit v; visit b
+    | .app f a => visit f; visit a
+    | .proj typeName _ b =>
+      modify fun (v, cs) => (v, cs.insert typeName)
+      visit b
+    | .const c _ =>
+      modify fun (v, cs) => (v, cs.insert c)
+    | .lit (.natVal _) =>
+      modify fun (v, cs) =>
+        (v, ((cs.insert ``Nat).insert ``Nat.zero).insert ``Nat.succ)
+    | .lit (.strVal _) =>
+      modify fun (v, cs) =>
+        let cs := (((cs.insert ``String).insert ``Char).insert ``String.ofList).insert ``Char.ofNat
+        let cs := (((cs.insert ``List).insert ``List.nil).insert ``List.cons).insert ``Nat
+        (v, (cs.insert ``Nat.zero).insert ``Nat.succ)
+    | _ => return ()
+  (visit e |>.run (mkPtrSet, {})).2.2
+
+@[implemented_by collectExprRefsUnsafe]
+private opaque collectExprRefs (e : Expr) : NameSet := {}
+
+private def getUsedRefs (c : ConstantInfo) : NameSet :=
+  let acc := collectExprRefs c.type
+  match c.value? (allowOpaque := true) with
+  | some v => acc.union (collectExprRefs v)
+  | none =>
+    match c with
+    | .inductInfo val => acc.union (NameSet.ofList val.ctors)
+    | .ctorInfo val => acc.insert val.name
+    | .recInfo val => acc.union (NameSet.ofList val.all)
+    | _ => acc
+
+private structure DeferredDecl where
+  name : Name
+  envBefore : Kernel.Environment
+  expected : ConstantInfo
+  decl : Declaration
+
+private structure Context where
+  newConstants : Std.HashMap Name ConstantInfo
+
+private structure State where
+  env : Kernel.Environment
+  remaining : NameSet := {}
+  inProgress : NameSet := {}
+  pending : NameSet := {}
+  postponedInductives : NameSet := {}
+  postponedConstructors : NameSet := {}
+  postponedRecursors : NameSet := {}
+  postponedQuotients : NameSet := {}
+  deferred : Array DeferredDecl := #[]
+
+private abbrev M := ReaderT Context <| StateRefT State IO
+
+private def throwKernelException (ex : Kernel.Exception) : IO α := do
+  throw <| .userError <| (← ex.toMessageData {} |>.toString)
+
+private def addDeclChecked (name : Name) (expected : ConstantInfo) (d : Declaration) : M Unit := do
+  match (← get).env.addDeclCore 0 0 d (cancelTk? := none) with
+  | .ok env =>
+    match env.find? name with
+    | some actual =>
+      if !(actual == expected) then
+        throw <| .userError s!"kernel constant mismatch after checking '{name}'"
+      modify fun s => { s with env := env }
+    | none =>
+      throw <| .userError s!"missing constant '{name}' after kernel check"
+  | .error ex => throwKernelException ex
+
+private def addInductChecked (d : Declaration) : M Unit := do
+  match (← get).env.addDeclCore 0 0 d (cancelTk? := none) with
+  | .ok env => modify fun s => { s with env := env }
+  | .error ex => throwKernelException ex
+
+private def deferDecl (name : Name) (expected : ConstantInfo) (d : Declaration) : M Unit := do
+  let envBefore := (← get).env
+  match envBefore.addDeclWithoutChecking d with
+  | .ok envAfter =>
+    match envAfter.find? name with
+    | some inserted =>
+      if !(inserted == expected) then
+        throw <| .userError s!"unchecked constant mismatch for '{name}'"
+      modify fun s => {
+        s with
+        env := envAfter
+        deferred := s.deferred.push { name, envBefore, expected, decl := d }
+      }
+    | none =>
+      throw <| .userError s!"missing constant '{name}' after unchecked insert"
+  | .error ex => throwKernelException ex
+
+mutual
+
+private partial def prepareConstant (name : Name) : M Unit := do
+  if (← get).inProgress.contains name then
+    throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+  if (← get).remaining.contains name then
+    modify fun s => {
+      s with
+      remaining := s.remaining.erase name
+      inProgress := s.inProgress.insert name
+      pending := s.pending.insert name
+    }
+    try
+      let some ci := (← read).newConstants[name]?
+        | throw <| .userError s!"missing constant '{name}'"
+      if ci.name != name then
+        throw <| .userError s!"mismatched constant name '{ci.name}' at key '{name}'"
+      match ci with
+      | .defnInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          deferDecl name ci (.defnDecl info)
+      | .thmInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          let alreadySubsumed ← do
+            if let some (.thmInfo info') := (← get).env.find? ci.name then
+              pure (info.name == info'.name &&
+                    info.type == info'.type &&
+                    info.levelParams == info'.levelParams &&
+                    info.all == info'.all)
+            else
+              pure false
+          if !alreadySubsumed then
+            deferDecl name ci (.thmDecl info)
+      | .opaqueInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          deferDecl name ci (.opaqueDecl info)
+      | .axiomInfo info =>
+        let deps := getUsedRefs ci
+        if deps.contains name then
+          throw <| .userError s!"cyclic declaration dependency involving '{name}'"
+        prepareConstants deps
+        if (← get).pending.contains name then
+          addDeclChecked name ci (.axiomDecl info)
+      | .inductInfo info =>
+        let lparams := info.levelParams
+        let nparams := info.numParams
+        if !info.all.contains name then
+          throw <| .userError s!"malformed inductive '{name}': missing from `all`"
+        let all ← info.all.mapM fun n => do
+          let some ci := (← read).newConstants[n]?
+            | throw <| .userError s!"missing mutual inductive '{n}'"
+          let .inductInfo _ := ci
+            | throw <| .userError s!"mutual inductive entry '{n}' is not an inductive"
+          if ci.name != n then
+            throw <| .userError s!"mismatched inductive name '{ci.name}' at key '{n}'"
+          pure ci
+        for o in all do
+          if o.name != name && (← get).inProgress.contains o.name then
+            throw <| .userError s!"cyclic dependency through mutual inductive '{o.name}'"
+        let ctorInfo ← all.mapM fun ci => do
+          pure (ci, ← ci.inductiveVal!.ctors.mapM fun n => do
+            let some c := (← read).newConstants[n]?
+              | throw <| .userError s!"missing constructor '{n}' for '{ci.name}'"
+            let .ctorInfo cval := c
+              | throw <| .userError s!"constant '{n}' for inductive '{ci.name}' is not a constructor"
+            if c.name != n then
+              throw <| .userError s!"mismatched constructor name '{c.name}' at key '{n}'"
+            if cval.induct != ci.name then
+              throw <| .userError s!"constructor '{n}' claims inductive '{cval.induct}', expected '{ci.name}'"
+            if (← get).inProgress.contains n then
+              throw <| .userError s!"cyclic dependency through constructor '{n}'"
+            pure c)
+        let blockNames := NameSet.ofList info.all
+        if blockNames.size != all.length then
+          throw <| .userError s!"malformed inductive '{name}': duplicate entries in `all`"
+        let mut blockCtors : NameSet := {}
+        for (_, ctors) in ctorInfo do
+          for c in ctors do
+            if blockCtors.contains c.name then
+              throw <| .userError s!"malformed inductive '{name}': duplicate constructor '{c.name}'"
+            if blockNames.contains c.name then
+              throw <| .userError s!"malformed inductive '{name}': constructor '{c.name}' collides with inductive name"
+            blockCtors := blockCtors.insert c.name
+        for o in all do
+          modify fun s => {
+            s with
+            remaining := s.remaining.erase o.name
+            pending := s.pending.erase o.name
+            inProgress := s.inProgress.insert o.name
+            postponedInductives := s.postponedInductives.insert o.name
+          }
+        for c in blockCtors do
+          modify fun s => {
+            s with
+            remaining := s.remaining.erase c
+            pending := s.pending.erase c
+            inProgress := s.inProgress.insert c
+            postponedConstructors := s.postponedConstructors.insert c
+          }
+        try
+          for o in all do
+            let deps := ((collectExprRefs o.type).diff blockNames).diff blockCtors
+            prepareConstants deps
+          for (_, ctors) in ctorInfo do
+            for ctor in ctors do
+              let deps := ((collectExprRefs ctor.type).diff blockNames).diff blockCtors
+              prepareConstants deps
+          let types : List InductiveType := ctorInfo.map fun (ci, ctors) =>
+            { name := ci.name
+              type := ci.type
+              ctors := ctors.map fun ci => { name := ci.name, type := ci.type } }
+          addInductChecked (.inductDecl lparams nparams types false)
+        finally
+          for o in all do
+            if o.name != name then
+              modify fun s => { s with inProgress := s.inProgress.erase o.name }
+          for c in blockCtors do
+            modify fun s => { s with inProgress := s.inProgress.erase c }
+      | .ctorInfo info =>
+        let deps := ((collectExprRefs info.type).erase name).erase info.induct
+        modify fun s => {
+          s with
+          postponedConstructors := s.postponedConstructors.insert info.name
+          pending := s.pending.erase name
+          inProgress := s.inProgress.erase name
+        }
+        prepareConstant info.induct
+        prepareConstants deps
+      | .recInfo info =>
+        let deps := info.rules.foldl (init := collectExprRefs info.type) fun acc rule =>
+          (acc.insert rule.ctor).union (collectExprRefs rule.rhs)
+        let deps := (deps.erase name).diff (NameSet.ofList info.all)
+        modify fun s => {
+          s with
+          postponedRecursors := s.postponedRecursors.insert info.name
+          pending := s.pending.erase name
+          inProgress := s.inProgress.erase name
+        }
+        for indName in info.all do
+          prepareConstant indName
+        prepareConstants deps
+      | .quotInfo _ =>
+        let quotNames : List Name := [``Quot, ``Quot.mk, ``Quot.lift, ``Quot.ind]
+        if !quotNames.contains name then
+          throw <| .userError s!"unexpected quotient declaration '{name}'"
+        let blockQuot := NameSet.ofList quotNames
+        for q in quotNames do
+          if q != name && (← get).inProgress.contains q then
+            throw <| .userError s!"cyclic dependency through quotient '{q}'"
+        let mut deps : NameSet := {}
+        for q in quotNames do
+          if let some qci := (← read).newConstants[q]? then
+            let .quotInfo _ := qci
+              | throw <| .userError s!"constant '{q}' must be a quotient declaration"
+            if qci.name != q then
+              throw <| .userError s!"mismatched quotient name '{qci.name}' at key '{q}'"
+            deps := deps.union ((getUsedRefs qci).diff blockQuot)
+            modify fun s => {
+              s with
+              remaining := s.remaining.erase q
+              pending := s.pending.erase q
+              inProgress := s.inProgress.insert q
+              postponedQuotients := s.postponedQuotients.insert q
+            }
+          else
+            modify fun s => { s with inProgress := s.inProgress.insert q }
+        try
+          prepareConstants deps
+          prepareConstant ``Eq
+          if ((← get).env.find? ``Quot).isNone then
+            addInductChecked .quotDecl
+        finally
+          for q in quotNames do
+            if q != name then
+              modify fun s => { s with inProgress := s.inProgress.erase q }
+      modify fun s => { s with pending := s.pending.erase name, inProgress := s.inProgress.erase name }
+    catch ex =>
+      modify fun s => { s with inProgress := s.inProgress.erase name }
+      throw <| .userError s!"while replaying declaration '{name}':\n{ex}"
+
+private partial def prepareConstants (names : NameSet) : M Unit := do
+  for n in names do
+    prepareConstant n
+
+end
+
+private def checkPostponedInductives : M Unit := do
+  for ind in (← get).postponedInductives do
+    match (← get).env.find? ind, (← read).newConstants[ind]? with
+    | some (.inductInfo info), some (.inductInfo info') =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid inductive {ind}"
+    | _, _ =>
+      throw <| IO.userError s!"No such inductive {ind}"
+
+private def checkPostponedConstructors : M Unit := do
+  for ctor in (← get).postponedConstructors do
+    match (← get).env.find? ctor, (← read).newConstants[ctor]? with
+    | some (.ctorInfo info), some (.ctorInfo info') =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid constructor {ctor}"
+    | _, _ =>
+      throw <| IO.userError s!"No such constructor {ctor}"
+
+private def checkPostponedRecursors : M Unit := do
+  for recName in (← get).postponedRecursors do
+    match (← get).env.find? recName, (← read).newConstants[recName]? with
+    | some (.recInfo info), some (.recInfo info') =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid recursor {recName}"
+    | _, _ =>
+      throw <| IO.userError s!"No such recursor {recName}"
+
+private def checkPostponedQuotients : M Unit := do
+  for qName in (← get).postponedQuotients do
+    match (← get).env.find? qName, (← read).newConstants[qName]? with
+    | some (.quotInfo info), some (.quotInfo info') =>
+      if !(info == info') then
+        throw <| IO.userError s!"Invalid quotient {qName}"
+    | _, _ =>
+      throw <| IO.userError s!"No such quotient {qName}"
+
+private partial def workerLoop
+    (deferred : Array DeferredDecl)
+    (nextIdx : IO.Ref Nat)
+    (checkedCount : IO.Ref Nat)
+    (firstError : IO.Ref (Option String))
+    (cancelTk : IO.CancelToken) : BaseIO Unit := do
+  if ← cancelTk.isSet then
+    return ()
+  let idx ← nextIdx.modifyGet fun i => (i, i + 1)
+  if h : idx < deferred.size then
+    let item := deferred[idx]
+    match item.envBefore.addDeclCore 0 0 item.decl (cancelTk? := some cancelTk) with
+    | .ok envChecked =>
+      match envChecked.find? item.name with
+      | some actual =>
+        if actual == item.expected then
+          checkedCount.modify (· + 1)
+          workerLoop deferred nextIdx checkedCount firstError cancelTk
+        else
+          let formatted := s!"while replaying declaration '{item.name}':\nkernel constant mismatch"
+          firstError.modify fun
+            | some prev => some prev
+            | none => some formatted
+          cancelTk.set
+      | none =>
+        let formatted := s!"while replaying declaration '{item.name}':\nmissing constant after kernel check"
+        firstError.modify fun
+          | some prev => some prev
+          | none => some formatted
+        cancelTk.set
+    | .error ex =>
+      if ex matches .interrupted then
+        if ← cancelTk.isSet then
+          return ()
+      let msg ← ex.toMessageData {} |>.toString
+      let formatted := s!"while replaying declaration '{item.name}':\n{msg}"
+      firstError.modify fun
+        | some prev => some prev
+        | none => some formatted
+      cancelTk.set
+  else
+    return ()
+
+@[noinline]
+private def prepareAll (newConstants : Std.HashMap Name ConstantInfo)
+    (env : Environment) : IO (Array DeferredDecl) := do
+  let mut remaining : NameSet := ∅
+  for (n, ci) in newConstants.toList do
+    if !ci.isUnsafe && !ci.isPartial then
+      remaining := remaining.insert n
+    else
+      throw <| IO.userError s!"unsafe or partial declaration '{n}' is not permitted in kernel replay"
+  let (_, s) ← StateRefT'.run (s := { env := env.toKernelEnv, remaining }) do
+    ReaderT.run (r := { newConstants }) do
+      for n in remaining do
+        prepareConstant n
+      checkPostponedInductives
+      checkPostponedConstructors
+      checkPostponedRecursors
+      checkPostponedQuotients
+  return s.deferred
+
+def checkParallel (numThreads : Nat) (newConstants : Std.HashMap Name ConstantInfo)
+    (env : Environment) : IO Unit := do
+  if numThreads == 0 then
+    throw <| IO.userError "checkParallel requires numThreads >= 1"
+  let deferred ← prepareAll newConstants env
+  let totalDeferred := deferred.size
+  if totalDeferred > 0 then
+    let workers := Nat.min numThreads totalDeferred
+    let nextIdx ← IO.mkRef 0
+    let checkedCount ← IO.mkRef 0
+    let firstError ← IO.mkRef (none : Option String)
+    let cancelTk ← IO.CancelToken.new
+    if workers == 1 then
+      workerLoop deferred nextIdx checkedCount firstError cancelTk
+    else
+      let mut tasks : Array (Task Unit) := Array.mkEmpty workers
+      for _ in [0:workers] do
+        let task ← BaseIO.asTask (prio := .dedicated)
+          (workerLoop deferred nextIdx checkedCount firstError cancelTk)
+        tasks := tasks.push task
+      for task in tasks do
+        let () ← IO.wait task
+    if let some err ← firstError.get then
+      throw <| IO.userError err
+    let actualChecked ← checkedCount.get
+    if actualChecked != totalDeferred then
+      throw <| IO.userError
+        s!"internal error: kernel checked {actualChecked} of {totalDeferred} deferred declarations"
+
+end Comparator.ParallelReplay
