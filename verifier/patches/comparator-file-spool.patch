+    | zero : Even 0
+    | succ : Odd n → Even (n + 1)
+
+  inductive Odd : Nat → Prop where
+    | succ : Even n → Odd (n + 1)
+end
+
+theorem boom : Even 2 := Even.succ (Odd.succ Even.zero)
